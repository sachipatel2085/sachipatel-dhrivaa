---
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { companyData } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string[];
  jsonLd?: Record<string, any>;
}

const {
  title = `${companyData.name} – Global Trade Partner | Agricultural Commodity Sourcing India`,
  description = 'Connecting global buyers with reliable agricultural commodity sources from India through transparent sourcing and procurement. Specializing in Rapeseed Meal, Castorseed Meal, and Castor Oil.',
  canonicalUrl = Astro.url.href,
  ogImage = '/images/hero-port.jpg',
  keywords = [
    'Agricultural Commodity Sourcing India',
    'Agricultural Products Procurement India',
    'Rapeseed Meal Supplier India',
    'Castorseed Meal Supplier India',
    'Castor Oil Supplier India',
    'Agricultural Sourcing Company Gujarat UAE'
  ],
  jsonLd
} = Astro.props;

const currentPath = Astro.url.pathname;

// Default Organization JSON-LD
const defaultOrgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companyData.name,
  legalName: companyData.legalEntity,
  url: 'https://dhrivaa.com',
  logo: 'https://dhrivaa.com/images/logo.png',
  description: description,
  sameAs: [
    companyData.socialLinks.linkedin,
    companyData.socialLinks.instagram
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Gujarat',
    addressCountry: 'IN'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: companyData.phone,
    contactType: 'Customer Sourcing Coordination',
    email: companyData.email,
    availableLanguage: ['English', 'Hindi', 'Gujarati']
  },
  areaServed: [
    'United Arab Emirates',
    'Saudi Arabia',
    'Oman',
    'Qatar',
    'Bahrain',
    'Kuwait'
  ],
  knowsAbout: [
    'Agricultural Commodity Sourcing',
    'Rapeseed Meal Procurement',
    'Castorseed Meal Sourcing',
    'Castor Oil Procurement',
    'Pre-Shipment Quality Coordination'
  ]
};

const finalJsonLd = jsonLd || defaultOrgJsonLd;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102B46" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={companyData.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={companyData.legalEntity} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
  </head>
  <body class="bg-surface-light text-trade-text flex flex-col min-h-screen antialiased selection:bg-navy-900 selection:text-gold" id="top">
    <!-- Top Sticky Navigation -->
    <Navbar client:load currentPath={currentPath} />

    <!-- Main Content Landmark -->
    <main class="flex-grow pt-[73px]">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Floating WhatsApp Action for Quick Buyer Inquiry -->
    <aside aria-label="Quick Communication" class="fixed bottom-1 right-10 z-40">
      <a
        href={companyData.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 group font-heading font-semibold text-xs tracking-wide"
        aria-label="Direct WhatsApp Procurement Chat"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="currentColor" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 fill-white stroke-none">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="hidden sm:inline font-medium">WhatsApp Sourcing</span>
      </a>
    </aside>
  </body>
</html>
