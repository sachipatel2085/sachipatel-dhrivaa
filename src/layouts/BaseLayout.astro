---
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';
import { companyData } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string[];
  jsonLd?: Record<string, any>;
}

const {
  title = `${companyData.name} – Global Trade Partner | Agricultural Commodity Sourcing India`,
  description = 'Connecting global buyers with reliable agricultural commodity sources from India through transparent sourcing and procurement. Specializing in Rapeseed Meal, Castorseed Meal, and Castor Oil.',
  canonicalUrl = Astro.url.href,
  ogImage = '/images/hero-port.jpg',
  keywords = [
    'Agricultural Commodity Sourcing India',
    'Agricultural Products Procurement India',
    'Rapeseed Meal Supplier India',
    'Castorseed Meal Supplier India',
    'Castor Oil Supplier India',
    'Agricultural Sourcing Company Gujarat UAE'
  ],
  jsonLd
} = Astro.props;

const currentPath = Astro.url.pathname;

// Default Organization JSON-LD
const defaultOrgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companyData.name,
  legalName: companyData.legalEntity,
  url: 'https://dhrivaa.com',
  logo: 'https://dhrivaa.com/images/logo.png',
  description: description,
  sameAs: [
    companyData.socialLinks.linkedin,
    companyData.socialLinks.instagram
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Gujarat',
    addressCountry: 'IN'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: companyData.phone,
    contactType: 'Customer Sourcing Coordination',
    email: companyData.email,
    availableLanguage: ['English', 'Hindi', 'Gujarati']
  },
  areaServed: [
    'United Arab Emirates',
    'Saudi Arabia',
    'Oman',
    'Qatar',
    'Bahrain',
    'Kuwait',
    'Global Markets'
  ],
  knowsAbout: [
    'Agricultural Commodity Sourcing',
    'Rapeseed Meal Procurement',
    'Castorseed Meal Sourcing',
    'Castor Oil Procurement',
    'Pre-Shipment Quality Coordination'
  ]
};

const finalJsonLd = jsonLd || defaultOrgJsonLd;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-stone-50 text-stone-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAFAF7" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={companyData.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={companyData.legalEntity} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
  </head>
  <body class="bg-stone-50 text-stone-900 flex flex-col min-h-screen antialiased selection:bg-forest selection:text-white" id="top">
    
    <!-- Top Floating Navigation -->
    <Navbar client:load currentPath={currentPath} />

    <!-- Main Content -->
    <main class="flex-grow pt-24 sm:pt-28">
      <slot />
    </main>

    <!-- Minimal Corporate Footer -->
    <Footer />

    <!-- Subtle Floating WhatsApp Action -->
    <div class="fixed bottom-5 right-5 z-40">
      <a
        href={companyData.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/95 border border-stone-200 text-stone-800 shadow-card hover:shadow-card-hover hover:border-forest/40 transition-all duration-200 text-xs font-medium"
        aria-label="Direct WhatsApp Procurement Chat"
      >
        <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Subtle Scroll Reveal Script -->
    <script is:inline>
      (function() {
        const initReveals = () => {
          const elements = document.querySelectorAll('.reveal-on-scroll, .reveal-fade, .reveal-scale, .reveal-slide-left, .reveal-slide-right');
          if (!elements.length) return;

          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  obs.unobserve(entry.target);
                }
              });
            }, {
              root: null,
              rootMargin: '0px 0px -30px 0px',
              threshold: 0.05
            });

            elements.forEach(el => observer.observe(el));
          } else {
            elements.forEach(el => el.classList.add('revealed'));
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveals);
        } else {
          initReveals();
        }
      })();
    </script>
  </body>
</html>
