---
import { ArrowRight } from 'lucide-react';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface TrustTag {
  text: string;
  color?: 'teal' | 'gold' | 'slate';
}

interface ButtonItem {
  label: string;
  href: string;
  isExternal?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  description: string;
  bannerImage: string;
  bannerAlt: string;
  breadcrumbs: BreadcrumbItem[];
  primaryButton?: ButtonItem;
  secondaryButton?: ButtonItem;
  trustTags?: TrustTag[];
  minHeightClass?: string;
}

const {
  eyebrow,
  title,
  titleAccent,
  description,
  bannerImage,
  bannerAlt,
  breadcrumbs,
  primaryButton,
  secondaryButton,
  trustTags = [],
} = Astro.props;
---

<section class="relative bg-stone-50 py-12 sm:py-16 lg:py-20 border-b border-stone-200 overflow-hidden" aria-label="Page Header">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Content (7 cols) -->
      <div class="lg:col-span-7 space-y-5 text-left">
        
        <!-- Breadcrumb Navigation -->
        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-stone-500" aria-label="Breadcrumb">
          {breadcrumbs.map((crumb, idx) => (
            <>
              {idx > 0 && <span class="text-stone-300">/</span>}
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-stone-900 transition-colors">
                  {crumb.label}
                </a>
              ) : (
                <span class="text-stone-900 font-medium" aria-current="page">
                  {crumb.label}
                </span>
              )}
            </>
          ))}
        </nav>

        {eyebrow && (
          <span class="text-xs font-semibold uppercase tracking-widest text-forest block">
            {eyebrow}
          </span>
        )}

        <!-- Main Headline -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-stone-900 tracking-tight leading-tight">
          {title} {titleAccent && <span class="font-editorial font-normal italic text-forest block mt-1">{titleAccent}</span>}
        </h1>

        <!-- Supporting Description -->
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed max-w-xl">
          {description}
        </p>

        <!-- CTA Buttons -->
        {(primaryButton || secondaryButton) && (
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            {primaryButton && (
              <a
                href={primaryButton.href}
                target={primaryButton.isExternal ? '_blank' : undefined}
                rel={primaryButton.isExternal ? 'noopener noreferrer' : undefined}
                class="btn-forest inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-xs font-semibold tracking-wide"
              >
                <span>{primaryButton.label}</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            )}

            {secondaryButton && (
              <a
                href={secondaryButton.href}
                class="btn-outline inline-flex items-center justify-center px-5 py-3 rounded-full text-xs font-semibold"
              >
                <span>{secondaryButton.label}</span>
              </a>
            )}
          </div>
        )}

        <!-- Trust Tags -->
        {trustTags.length > 0 && (
          <div class="pt-3 border-t border-stone-200/80 flex flex-wrap items-center gap-2 text-xs text-stone-500 font-medium">
            {trustTags.map((tag) => (
              <span class="px-2.5 py-1 rounded-md bg-stone-100 border border-stone-200 text-stone-700 text-[11px]">
                {tag.text}
              </span>
            ))}
          </div>
        )}

      </div>

      <!-- Right Topic Photo (5 cols) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl overflow-hidden border border-stone-200 bg-stone-100 shadow-card aspect-[4/3] group">
          <img
            src={bannerImage}
            alt={bannerAlt}
            class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-103"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </div>
</section>
