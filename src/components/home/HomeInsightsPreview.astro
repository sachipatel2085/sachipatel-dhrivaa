---
import { ArrowRight, Calendar, Clock, BookOpen } from 'lucide-react';
import { insightsData } from '../../data/insights';

const featuredInsights = insightsData.slice(0, 3);
---

<section class="py-20 lg:py-28 bg-surface-light border-b border-slate-200 relative overflow-hidden" aria-labelledby="insights-preview-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-[0.22em] text-teal font-heading">
          Market Intelligence &amp; Analysis
        </span>
        <h2 id="insights-preview-heading" class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-navy-900 tracking-tight leading-tight">
          International Trade <br />
          <span class="font-serif italic font-normal text-gold">Insights &amp; Analysis.</span>
        </h2>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          In-depth procurement intelligence, maritime route analyses, and quality benchmarks authored by DHRIVAA’s agricultural sourcing team.
        </p>
      </div>

      <div class="flex-shrink-0">
        <a
          href="/insights"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-navy-900 hover:bg-navy-850 text-white font-heading font-bold text-xs uppercase tracking-wider transition-colors shadow-sm"
        >
          <span>View All Trade Insights</span>
          <ArrowRight className="w-3.5 h-3.5 text-gold" />
        </a>
      </div>
    </div>

    <!-- Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredInsights.map((article) => (
        <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-card hover:shadow-premium transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1">
          <div>
            <!-- Image Aspect Wrapper with Zoom Effect -->
            <div class="relative aspect-[16/10] overflow-hidden bg-navy-950">
              <img
                src={article.image}
                alt={article.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-[0.95]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent"></div>
              
              <!-- Category Badge -->
              <div class="absolute bottom-3.5 left-4">
                <span class="inline-block px-3 py-1 rounded-full bg-navy-900/90 text-gold-light border border-gold/30 text-[10px] font-heading font-bold uppercase tracking-wider backdrop-blur-md">
                  {article.category}
                </span>
              </div>
            </div>

            <!-- Content Body -->
            <div class="p-6 sm:p-7 space-y-3">
              <!-- Meta Row -->
              <div class="flex items-center gap-4 text-xs text-slate-400">
                <span class="flex items-center gap-1.5">
                  <Calendar className="w-3.5 h-3.5 text-teal" />
                  <time datetime={article.publishDate}>{article.publishDate}</time>
                </span>
                <span>&bull;</span>
                <span class="flex items-center gap-1.5">
                  <Clock className="w-3.5 h-3.5 text-teal" />
                  <span>{article.readTime}</span>
                </span>
              </div>

              <!-- Title -->
              <h3 class="font-heading font-bold text-lg sm:text-xl text-navy-900 group-hover:text-teal transition-colors line-clamp-2 leading-snug">
                <a href={`/insights/${article.slug}`}>
                  {article.title}
                </a>
              </h3>

              <!-- Excerpt -->
              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal">
                {article.excerpt}
              </p>
            </div>
          </div>

          <!-- Footer Read Link -->
          <div class="px-6 sm:px-7 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">
              Editorial Analysis
            </span>
            <a
              href={`/insights/${article.slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-heading font-bold text-navy-900 hover:text-teal uppercase tracking-wider transition-colors group/btn"
            >
              <span>Read Article</span>
              <ArrowRight className="w-3.5 h-3.5 text-gold group-hover/btn:translate-x-1 transition-transform" />
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
