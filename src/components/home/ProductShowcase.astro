---
import { productsData } from '../../data/products';
import { ArrowRight } from 'lucide-react';
---

<section class="py-16 sm:py-24 bg-white border-t border-stone-200" aria-labelledby="products-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-2xl mb-12 sm:mb-16">
      <span class="text-xs font-semibold uppercase tracking-widest text-forest">
        Core Commodities
      </span>
      <h2 id="products-heading" class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight mt-1.5">
        Sourced for Global Industry
      </h2>
      <p class="text-stone-600 text-sm sm:text-base leading-relaxed mt-2">
        We specialize in three primary agricultural by-products and vegetable oils sourced from vetted extraction units in western India.
      </p>
    </div>

    <!-- 3 Minimal Product Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {productsData.map((product, idx) => (
        <article class={`reveal-on-scroll delay-${(idx + 1) * 100} bg-stone-50 rounded-2xl overflow-hidden border border-stone-200 hover:border-forest/40 hover-lift transition-all duration-300 flex flex-col justify-between group`}>
          
          <!-- Image -->
          <div class="relative aspect-[4/3] overflow-hidden bg-stone-100">
            <img
              src={product.image}
              alt={product.alt}
              class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-104"
              loading="lazy"
            />
          </div>

          <!-- Body -->
          <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <h3 class="text-lg sm:text-xl font-bold text-stone-900 group-hover:text-forest transition-colors">
                {product.name}
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed line-clamp-3">
                {product.shortDescription}
              </p>
            </div>

            <!-- View Details Link -->
            <div class="pt-3 border-t border-stone-200/70">
              <a
                href={`/products/${product.slug}`}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-stone-900 group-hover:text-forest transition-colors"
              >
                <span>View Details</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" />
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/products"
        class="inline-flex items-center gap-2 text-xs font-semibold text-forest hover:underline"
      >
        <span>View all commodity specifications &amp; packaging standards</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>
