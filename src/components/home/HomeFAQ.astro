---
import { HelpCircle, ChevronDown, ArrowRight, ShieldCheck } from 'lucide-react';

const faqs = [
  {
    question: 'What is DHRIVAA’s business model and legal role in procurement?',
    answer: 'DHRIVAA is an independent sourcing coordinator in Gujarat, India. We do not operate manufacturing facilities. We represent international buyers by vetting extraction plants, coordinating laboratory testing, and managing export logistics through Mundra and Kandla ports.'
  },
  {
    question: 'Which international seaports and target markets do you serve?',
    answer: 'We coordinate shipments from Mundra and Kandla to key seaports across the Arabian Gulf (UAE, Saudi Arabia, Oman, Qatar, Bahrain, Kuwait), as well as Australia, the United States, and the United Kingdom.'
  },
  {
    question: 'How does DHRIVAA ensure product quality before export shipment?',
    answer: 'Batch samples are tested at accredited ISO/IEC 17025 laboratories for contracted parameters before dispatch. Buyers receive a certified Certificate of Analysis (COA), and third-party inspections (SGS, Geo-Chem) can be arranged upon request.'
  },
  {
    question: 'What commercial Incoterms and payment mechanisms are supported?',
    answer: 'We coordinate shipments under Incoterms 2020 (FOB Mundra/Kandla or CFR/CIF destination port). Payment is typically structured via Irrevocable Letters of Credit (LC at Sight) or Telegraphic Transfer (T/T).'
  },
  {
    question: 'What is the ocean transit timeframe from Gujarat to Middle Eastern ports?',
    answer: 'Direct container sailings from Mundra and Kandla reach UAE ports in 3 to 5 days, and Saudi Arabia or Oman in 5 to 8 days, minimizing transit time and preserving cargo quality.'
  },
  {
    question: 'Can buyers request customized packaging, bag weights, and bilingual labeling?',
    answer: 'Yes. Options include 50 kg PP bags, 1,000 kg jumbo bags, bulk container liners, 200L drums, and flexitanks, complete with custom markings and bilingual labeling as required.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<section class="py-20 lg:py-28 bg-white border-b border-slate-200 relative overflow-hidden" aria-labelledby="faq-heading">
  <!-- FAQ JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header with Scroll Reveal -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
        Buyer Questions
      </span>
      <h2 id="faq-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-base text-slate-600 leading-relaxed font-normal">
        Clear answers about our sourcing process, quality checks, packaging, and shipping from Gujarat to the Middle East.
      </p>
    </div>

    <!-- Accordion FAQ Items with Staggered Scroll Reveals -->
    <div class="space-y-4">
      {faqs.map((faq, idx) => (
        <details
          class={`reveal-on-scroll delay-${(idx + 1) * 75} group bg-surface-light hover:bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 transition-all duration-300 shadow-subtle hover:shadow-card hover-lift open:bg-white open:border-gold/50 open:shadow-card`}
          open={idx === 0}
        >
          <summary class="flex items-center justify-between cursor-pointer list-none focus:outline-none select-none">
            <h3 class="font-heading font-bold text-base sm:text-lg text-navy-900 group-hover:text-teal group-open:text-navy-950 transition-colors flex items-center gap-3 pr-4">
              <span class="w-2 h-2 rounded-full bg-teal flex-shrink-0 group-open:bg-gold transition-colors"></span>
              <span>{faq.question}</span>
            </h3>
            <div class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-slate-200 group-open:bg-navy-900 group-open:text-gold flex items-center justify-center flex-shrink-0 transition-colors text-slate-500">
              <ChevronDown className="w-4 h-4 transform group-open:rotate-180 transition-transform duration-300" />
            </div>
          </summary>
          <div class="pt-4 mt-3 border-t border-slate-100 text-sm text-slate-600 leading-relaxed font-normal pl-5">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Additional Inquiries Footer -->
    <div class="reveal-scale delay-150 mt-12 text-center p-6 rounded-2xl bg-surface-light border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-left">
        <HelpCircle className="w-5 h-5 text-teal flex-shrink-0" />
        <span class="text-xs sm:text-sm text-slate-700 font-medium">
          Have specific commercial questions regarding contract terms, minimum order quantities, or destination port clearances?
        </span>
      </div>
      <a
        href="/contact"
        class="btn-navy-interactive group inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-navy-900 hover:bg-navy-850 text-white font-heading font-bold text-xs uppercase tracking-wider flex-shrink-0"
      >
        <span>Ask Our Sourcing Desk</span>
        <ArrowRight className="w-3.5 h-3.5 text-gold group-hover:translate-x-1.5 transition-transform duration-200" />
      </a>
    </div>

  </div>
</section>
