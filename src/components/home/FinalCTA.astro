---
import { companyData } from '../../data/company';
import { ArrowRight, MessageSquare } from 'lucide-react';
---

<section class="py-16 sm:py-20 bg-stone-50 border-t border-stone-200" aria-labelledby="final-cta-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    
    <div class="space-y-2">
      <span class="text-xs font-semibold uppercase tracking-widest text-forest">
        Trade Coordination
      </span>
      <h2 id="final-cta-heading" class="text-2xl sm:text-3xl md:text-4xl font-bold text-stone-900 tracking-tight">
        Sourcing the Right Agricultural Commodities
      </h2>
      <p class="text-stone-600 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Share your procurement requirements and our team in Gujarat will work directly with you to structure reliable sourcing from vetted extraction units.
      </p>
    </div>

    <!-- Dual Actions -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
      <a
        href="/contact"
        class="btn-forest w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide shadow-subtle hover:shadow-sm"
      >
        <span>Request a Quote</span>
        <ArrowRight className="w-4 h-4" />
      </a>

      <a
        href={companyData.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold"
      >
        <MessageSquare className="w-4 h-4 text-[#25D366]" />
        <span>Chat on WhatsApp</span>
      </a>
    </div>

    <div class="pt-4 border-t border-stone-200/80 text-xs text-stone-500 max-w-md mx-auto flex items-center justify-center gap-4">
      <span>Direct Mill Coordination</span>
      <span>&bull;</span>
      <span>Mundra &amp; Kandla Ports</span>
      <span>&bull;</span>
      <span>Prompt Response</span>
    </div>

  </div>
</section>
