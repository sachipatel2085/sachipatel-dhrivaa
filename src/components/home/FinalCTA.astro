---
import { companyData } from '../../data/company';
import { ArrowRight, MessageSquare, PhoneCall } from 'lucide-react';
---

<section class="py-20 lg:py-24 bg-navy-950 text-white relative overflow-hidden" aria-labelledby="cta-heading">
  <!-- Subtle organic background lighting -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-teal/20 via-navy-950 to-navy-950 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy-900 border border-gold/30 text-gold-light text-xs font-heading font-semibold uppercase tracking-widest">
      <span>Direct Commodity Procurement Mandate</span>
    </div>

    <h2 id="cta-heading" class="font-heading font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight leading-tight max-w-3xl mx-auto text-balance">
      Let's Source the Right Product for Your Market.
    </h2>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Share your procurement requirements and our team will work with you to identify suitable sourcing opportunities from verified Indian suppliers.
    </p>

    <!-- Dual Actions -->
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      <!-- Quote Form Link -->
      <a
        href="/contact"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-sm uppercase tracking-wider transition-all duration-300 shadow-gold-glow hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>Request a Quote</span>
        <ArrowRight className="w-4 h-4" />
      </a>

      <!-- Direct WhatsApp Action -->
      <a
        href={companyData.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-sm tracking-wide transition-all duration-300 shadow-lg hover:shadow-2xl hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="currentColor" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 fill-white stroke-none">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Chat on WhatsApp</span>
      </a>
    </div>

    <!-- Assurance footnote -->
    <div class="pt-6 border-t border-navy-800 text-xs text-slate-400 max-w-lg mx-auto flex items-center justify-center gap-6">
      <span>Dedicated Account Manager</span>
      <span class="w-1 h-1 rounded-full bg-slate-600"></span>
      <span>Prompt Response</span>
      <span class="w-1 h-1 rounded-full bg-slate-600"></span>
      <span>Direct Mill Coordination</span>
    </div>

  </div>
</section>
