---
import { ShieldCheck, Target, Eye, FileText, CheckCircle2, Lock, ArrowRight } from 'lucide-react';

const commitments = [
  {
    icon: Target,
    title: 'Independent Buyer Representation',
    subtitle: 'Zero Factory Bias',
    description: 'We source strictly according to buyer specifications rather than liquidating mill inventory, ensuring unbiased supplier selection.'
  },
  {
    icon: Eye,
    title: 'Pre-Shipment Laboratory Verification',
    subtitle: 'COA Before Dispatch',
    description: 'Independent laboratory testing before dispatch ensures moisture, protein, or acid value parameters meet contracted standards.'
  },
  {
    icon: Lock,
    title: 'Container Stuffing & Sealing',
    subtitle: 'Cargo Security',
    description: 'Supervised container stuffing and verified sealing protect product integrity and moisture control throughout ocean transit.'
  },
  {
    icon: FileText,
    title: 'Complete Trade Documentation',
    subtitle: 'Seamless Clearance',
    description: 'Prompt coordination of Bills of Lading, Phytosanitary certificates, and Certificates of Origin for rapid customs release.'
  }
];

const guarantees = [
  'Competitive pricing based on prevailing regional market benchmarks',
  'Strict adherence to contracted Incoterms (FOB Mundra/Kandla or CIF)',
  'Direct communication with dedicated sourcing coordinators in Gujarat',
  'Third-party inspections (SGS, Geo-Chem) facilitated upon request'
];
---

<section class="py-20 lg:py-28 bg-white border-b border-slate-200 relative overflow-hidden" aria-labelledby="commitment-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Editorial Manifesto (5 cols) with Slide Reveal -->
      <div class="reveal-slide-left lg:col-span-5 space-y-6">
        <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
          Buyer Protection
        </span>
        <h2 id="commitment-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
          How We Protect Your Interests as a Buyer
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          In bulk agricultural commodities, confidence comes from verified lab results, supervised container stuffing, and clear documentation.
        </p>

        <!-- Positioning Callout Box -->
        <div class="p-5 rounded-2xl bg-surface-light border border-slate-200/90 text-xs sm:text-sm text-slate-700 space-y-3 hover-lift">
          <div class="flex items-center gap-2 text-navy-900 font-bold font-heading">
            <ShieldCheck className="w-5 h-5 text-teal" />
            <span>The Independent Procurement Advantage</span>
          </div>
          <p class="text-slate-600 leading-relaxed text-xs">
            DHRIVAA acts as your dedicated procurement office in India. We represent buyer interests, selecting vetted processing facilities strictly according to your quality specifications.
          </p>
        </div>

        <!-- Guarantee Checklist -->
        <div class="space-y-3 pt-2">
          {guarantees.map((item) => (
            <div class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
              <CheckCircle2 className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
              <span>{item}</span>
            </div>
          ))}
        </div>

        <div class="pt-4">
          <a
            href="/sourcing-procurement"
            class="btn-navy-interactive group inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-navy-900 hover:bg-navy-850 text-white font-heading font-bold text-xs uppercase tracking-wider shadow-sm"
          >
            <span>Explore Our Sourcing Methodology</span>
            <ArrowRight className="w-3.5 h-3.5 text-gold group-hover:translate-x-1.5 transition-transform duration-200" />
          </a>
        </div>
      </div>

      <!-- Right Column: 4 Commitment Pillars (7 cols) with Staggered Scroll Reveals -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {commitments.map((c, idx) => {
          const Icon = c.icon;
          return (
            <div class={`reveal-on-scroll delay-${(idx + 1) * 100} bg-surface-light p-7 rounded-2xl border border-slate-200 shadow-card hover:shadow-premium hover-lift glow-card transition-all duration-300 flex flex-col justify-between group`}>
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div class="icon-box-interactive w-12 h-12 rounded-xl bg-navy-900 text-gold flex items-center justify-center group-hover:bg-gold group-hover:text-navy-950 transition-colors shadow-sm">
                    <Icon className="w-6 h-6" />
                  </div>
                  <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-teal transition-colors">
                    0{idx + 1}
                  </span>
                </div>

                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-teal block mb-1">
                    {c.subtitle}
                  </span>
                  <h3 class="font-heading font-bold text-lg text-navy-900 group-hover:text-teal transition-colors">
                    {c.title}
                  </h3>
                </div>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                  {c.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
