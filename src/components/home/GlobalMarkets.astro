---
import { ArrowRight, Globe2, Anchor, Navigation, ShieldCheck, Box, FileText, CheckCircle2 } from 'lucide-react';
import TradeCorridorsMap from './TradeCorridorsMap';

const logisticsCapabilities = [
  {
    icon: Anchor,
    title: 'Dual Origin Ports',
    desc: 'Berths at Mundra & Deendayal Port (Kandla) with bulk & container handling.'
  },
  {
    icon: Box,
    title: 'Flexible Cargo Modes',
    desc: 'Break-bulk charters (5,000–25,000 MT) & 20ft FCL containerized shipments.'
  },
  {
    icon: FileText,
    title: 'Trade Documentation',
    desc: 'SGS / Geo-Chem inspection, Phytosanitary, and Embassy Legalized COO.'
  },
  {
    icon: ShieldCheck,
    title: 'Regional Compliance',
    desc: 'Aligned with UAE MOIAT, Saudi SFDA, and GCC Unified Quarantine standards.'
  }
];

const targetCorridors = [
  { country: 'UAE', ports: 'Jebel Ali, Khalifa' },
  { country: 'Saudi Arabia', ports: 'Dammam, Jeddah' },
  { country: 'Oman', ports: 'Sohar, Salalah' },
  { country: 'Qatar', ports: 'Hamad Port' },
  { country: 'Bahrain', ports: 'Khalifa Bin Salman' },
  { country: 'Kuwait', ports: 'Shuwaikh, Shuaiba' },
  { country: 'Australia', ports: 'Melbourne, Fremantle' },
  { country: 'United States', ports: 'Houston, NY/NJ' },
  { country: 'United Kingdom', ports: 'Felixstowe, London' }
];
---

<section class="py-20 lg:py-28 bg-white overflow-hidden relative" aria-labelledby="global-markets-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Scroll Reveal -->
    <div class="reveal-on-scroll max-w-3xl space-y-3 mb-10 sm:mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
        Global Trade Corridors
      </span>
      <h2 id="global-markets-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
        Shipping from Gujarat to Global Seaports
      </h2>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Connecting Gujarat processing facilities to key seaports across the Arabian Gulf, Australia, the United States, and the United Kingdom.
      </p>
    </div>

    <!-- Map & Logistics Side-by-Side Presentation Stage (Light Theme) -->
    <div class="reveal-scale delay-100 bg-slate-50 rounded-3xl p-6 sm:p-8 lg:p-10 text-navy-900 relative overflow-hidden shadow-premium border border-slate-200/90">
      
      <!-- Background Ambient Grid & Soft Radial Glows -->
      <div class="absolute inset-0 bg-[radial-gradient(#CBD5E1_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-teal/5 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Left & Right Split Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch relative z-10">
        
        <!-- Left: Animated Route Map in Light Chart Card (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-sm flex flex-col justify-between">
          <TradeCorridorsMap client:visible />
        </div>

        <!-- Right: Logistics Capabilities & Target Markets (5 cols) -->
        <div class="reveal-slide-right delay-200 lg:col-span-5 flex flex-col justify-between space-y-6">
          
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-gold"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
                Logistics Capabilities
              </span>
            </div>
            <h3 class="font-heading font-bold text-2xl text-navy-900">
              Sourcing &amp; Ocean Freight Infrastructure
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-2">
              We coordinate procurement from vetted Gujarat processors, managing port handling and export clearance to primary seaports.
            </p>
          </div>

          <!-- Logistics Capabilities Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {logisticsCapabilities.map((cap) => {
              const Icon = cap.icon;
              return (
                <div class="bg-white rounded-xl p-3.5 border border-slate-200 hover:border-gold/60 shadow-sm hover-lift transition-all">
                  <div class="flex items-center gap-2 mb-1.5">
                    <span class="w-6 h-6 rounded-lg bg-teal/10 border border-teal/20 flex items-center justify-center text-teal shrink-0">
                      <Icon className="w-3.5 h-3.5" />
                    </span>
                    <h4 class="font-heading font-bold text-xs text-navy-900 leading-tight">{cap.title}</h4>
                  </div>
                  <p class="text-[11px] text-slate-600 leading-normal">{cap.desc}</p>
                </div>
              );
            })}
          </div>

          <!-- Target Destinations Quick Summary -->
          <div class="bg-slate-100/80 rounded-xl p-3.5 border border-slate-200">
            <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider block mb-2 font-heading">
              Primary Trade Corridors
            </span>
            <div class="grid grid-cols-3 gap-2">
              {targetCorridors.map((c) => (
                <div class="text-[11px] bg-white p-2 rounded-lg border border-slate-200/80 shadow-2xs">
                  <span class="font-semibold text-navy-900 block truncate">{c.country}</span>
                  <span class="text-[10px] text-slate-500 block truncate">{c.ports}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Bottom Full-Width Action & Legal Bar -->
      <div class="mt-8 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6 relative z-10">
        <p class="text-xs text-slate-500 italic max-w-3xl leading-relaxed text-center sm:text-left">
          *DHRIVAA facilitates trade and procurement coordination between verified Indian crushing facilities and international buyers. We communicate genuine sourcing opportunities without making unwarranted claims.
        </p>

        <a
          href="/contact"
          class="btn-gold-interactive shrink-0 inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
        >
          <span>Discuss Destination Logistics</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

    </div>

  </div>
</section>
