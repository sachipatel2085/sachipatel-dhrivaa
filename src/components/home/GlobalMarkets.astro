---
import { ArrowRight, Globe2, Anchor, Navigation, ShieldCheck, Box, FileText, CheckCircle2 } from 'lucide-react';
import TradeCorridorsMap from './TradeCorridorsMap';

const logisticsCapabilities = [
  {
    icon: Anchor,
    title: 'Dual Origin Ports',
    desc: 'Direct loading berths at Mundra Port & Deendayal Port (Kandla) with deep-draft container & bulk terminals.'
  },
  {
    icon: Box,
    title: 'Flexible Cargo Modes',
    desc: 'Break-bulk vessel charters (5,000–25,000 MT) and 20ft FCL containerized shipments with moisture barrier liners.'
  },
  {
    icon: FileText,
    title: 'Trade Documentation',
    desc: 'SGS/Geo-Chem inspection, Phytosanitary certification, Certificate of Origin, and COO legalize by GCC embassies.'
  },
  {
    icon: ShieldCheck,
    title: 'Regional Compliance',
    desc: 'Formulations strictly aligned with UAE MOIAT, Saudi SFDA, and GCC Unified Quarantine import standards.'
  }
];
---

<section class="py-20 lg:py-28 bg-white overflow-hidden relative" aria-labelledby="global-markets-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Scroll Reveal -->
    <div class="reveal-on-scroll max-w-3xl space-y-4 mb-12 sm:mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
        Global Trade Corridors
      </span>
      <h2 id="global-markets-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
        Shipping from Gujarat to Arabian Gulf Seaports &amp; Global Markets
      </h2>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Connecting crushing mills in western India directly to major commercial ports across the UAE, Saudi Arabia, Oman, Qatar, Bahrain, Kuwait, and global maritime shipping corridors.
      </p>
    </div>

    <!-- Map & Trade Corridor Interactive Visual Stage with Scale Reveal -->
    <div class="reveal-scale delay-100 bg-navy-950 rounded-3xl p-5 sm:p-8 lg:p-10 text-white relative overflow-hidden shadow-premium border border-slate-800">
      
      <!-- Background Ambient Grid & Radial Aura -->
      <div class="absolute inset-0 bg-[radial-gradient(#193F66_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-teal/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Interactive React World Map Component -->
      <div class="relative z-10">
        <TradeCorridorsMap client:visible />
      </div>

      <!-- Logistics Specifications & Action Bar -->
      <div class="relative z-10 mt-10 pt-8 border-t border-slate-800/80">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {logisticsCapabilities.map((cap) => {
            const Icon = cap.icon;
            return (
              <div class="bg-navy-900/60 rounded-xl p-4 border border-slate-800/80 hover:border-gold/30 transition-colors">
                <div class="flex items-center gap-2.5 mb-2">
                  <span class="w-7 h-7 rounded-lg bg-teal/10 border border-teal/20 flex items-center justify-center text-teal">
                    <Icon className="w-3.5 h-3.5" />
                  </span>
                  <h4 class="font-heading font-bold text-sm text-white">{cap.title}</h4>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">{cap.desc}</p>
              </div>
            );
          })}
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-4 border-t border-slate-800/60">
          <p class="text-[11px] text-slate-400 italic max-w-2xl text-center sm:text-left">
            *DHRIVAA facilitates trade and procurement coordination between verified Indian crushing facilities and international buyers. We communicate genuine sourcing opportunities without making unwarranted claims.
          </p>

          <a
            href="/contact"
            class="btn-gold-interactive shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-xs uppercase tracking-wider"
          >
            <span>Discuss Destination Logistics</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
