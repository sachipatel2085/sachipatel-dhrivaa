---
import { ArrowRight, Globe2, Anchor, Navigation, ShieldCheck, Box, FileText, CheckCircle2 } from 'lucide-react';
import TradeCorridorsMap from './TradeCorridorsMap';

const logisticsCapabilities = [
  {
    icon: Anchor,
    title: 'Dual Origin Ports',
    desc: 'Berths at Mundra & Deendayal Port (Kandla) with bulk & container handling.'
  },
  {
    icon: Box,
    title: 'Flexible Cargo Modes',
    desc: 'Break-bulk charters (5,000–25,000 MT) & 20ft FCL containerized shipments.'
  },
  {
    icon: FileText,
    title: 'Trade Documentation',
    desc: 'SGS / Geo-Chem inspection, Phytosanitary, and Embassy Legalized COO.'
  },
  {
    icon: ShieldCheck,
    title: 'Regional Compliance',
    desc: 'Aligned with UAE MOIAT, Saudi SFDA, and GCC Unified Quarantine standards.'
  }
];

const targetCorridors = [
  { country: 'UAE', ports: 'Jebel Ali, Khalifa' },
  { country: 'Saudi Arabia', ports: 'Dammam, Jeddah' },
  { country: 'Oman', ports: 'Sohar, Salalah' },
  { country: 'Qatar', ports: 'Hamad Port' },
  { country: 'Bahrain', ports: 'Khalifa Bin Salman' },
  { country: 'Kuwait', ports: 'Shuwaikh, Shuaiba' }
];
---

<section class="py-20 lg:py-28 bg-white overflow-hidden relative" aria-labelledby="global-markets-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Scroll Reveal -->
    <div class="reveal-on-scroll max-w-3xl space-y-3 mb-10 sm:mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
        Global Trade Corridors
      </span>
      <h2 id="global-markets-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
        Shipping from Gujarat to Arabian Gulf Seaports
      </h2>
      <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
        Connecting crushing facilities in western India directly to primary commercial seaports across the Arabian Gulf with verified transit timelines and full documentation.
      </p>
    </div>

    <!-- Map & Logistics Side-by-Side Presentation Stage -->
    <div class="reveal-scale delay-100 bg-navy-950 rounded-3xl p-6 sm:p-8 lg:p-10 text-white relative overflow-hidden shadow-premium border border-slate-800">
      
      <!-- Background Ambient Grid & Radial Glows -->
      <div class="absolute inset-0 bg-[radial-gradient(#193F66_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-teal/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Left & Right Split Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center relative z-10">
        
        <!-- Left: Animated Route Map (7 cols) -->
        <div class="lg:col-span-7 bg-navy-900/80 rounded-2xl p-4 sm:p-5 border border-slate-800 shadow-card flex flex-col justify-between">
          <TradeCorridorsMap client:visible />
        </div>

        <!-- Right: Logistics Capabilities & Target Markets (5 cols) -->
        <div class="reveal-slide-right delay-200 lg:col-span-5 flex flex-col justify-between space-y-6">
          
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-gold"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-gold font-heading">
                Logistics Capabilities
              </span>
            </div>
            <h3 class="font-heading font-bold text-2xl text-white">
              Sourcing &amp; Ocean Freight Infrastructure
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mt-2">
              We coordinate procurement directly from verified Gujarat crushing mills, securing deep-draft berths and end-to-end export clearance for GCC destinations.
            </p>
          </div>

          <!-- Logistics Capabilities Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {logisticsCapabilities.map((cap) => {
              const Icon = cap.icon;
              return (
                <div class="bg-navy-900/90 rounded-xl p-3.5 border border-slate-800 hover:border-gold/40 transition-colors">
                  <div class="flex items-center gap-2 mb-1.5">
                    <span class="w-6 h-6 rounded-lg bg-teal/15 border border-teal/25 flex items-center justify-center text-teal shrink-0">
                      <Icon className="w-3 h-3" />
                    </span>
                    <h4 class="font-heading font-bold text-xs text-white leading-tight">{cap.title}</h4>
                  </div>
                  <p class="text-[11px] text-slate-300 leading-normal">{cap.desc}</p>
                </div>
              );
            })}
          </div>

          <!-- Target Destinations Quick Summary -->
          <div class="bg-navy-900/50 rounded-xl p-3.5 border border-slate-800/80">
            <span class="text-[11px] font-bold text-slate-300 uppercase tracking-wider block mb-2 font-heading">
              Target Arabian Gulf Corridors
            </span>
            <div class="grid grid-cols-3 gap-2">
              {targetCorridors.map((c) => (
                <div class="text-[11px] bg-navy-950/60 p-2 rounded-lg border border-slate-800">
                  <span class="font-semibold text-white block truncate">{c.country}</span>
                  <span class="text-[10px] text-slate-400 block truncate">{c.ports}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA & Legal Note -->
          <div class="pt-1 space-y-3">
            <a
              href="/contact"
              class="btn-gold-interactive w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-xs uppercase tracking-wider"
            >
              <span>Discuss Destination Logistics</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>

            <p class="text-[10px] text-slate-400 italic pt-1 border-t border-slate-800/60">
              *DHRIVAA facilitates trade and procurement coordination between verified Indian crushing facilities and international buyers. We communicate genuine sourcing opportunities without making unwarranted claims.
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
