---
const steps = [
  {
    step: '01',
    title: 'Understand Requirements',
    description: 'We review your target technical parameters, required volume (FCL or break-bulk), preferred packaging format, destination port, and delivery schedule.'
  },
  {
    step: '02',
    title: 'Source and Coordinate',
    description: 'We evaluate vetted solvent extraction units and expeller mills across western India to match your capacity, pricing targets, and quality standards.'
  },
  {
    step: '03',
    title: 'Quality Verification',
    description: 'We coordinate pre-shipment composite sampling, independent certified lab assays (COA), and packaging inspection before goods leave the processing facility.'
  },
  {
    step: '04',
    title: 'Shipment Coordination',
    description: 'We oversee container stuffing, port carting to Mundra or Kandla, customs clearance, and issuance of Phytosanitary and Certificate of Origin documentation.'
  }
];
---

<section class="py-16 sm:py-24 bg-stone-100 border-t border-stone-200" aria-labelledby="how-we-work-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-2xl mb-12 sm:mb-16">
      <span class="text-xs font-semibold uppercase tracking-widest text-forest">
        Working Process
      </span>
      <h2 id="how-we-work-heading" class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight mt-1.5">
        How We Work
      </h2>
      <p class="text-stone-600 text-sm sm:text-base leading-relaxed mt-2">
        A structured, linear procurement workflow designed for clarity and reliability from inquiry to port loading.
      </p>
    </div>

    <!-- 4 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s, idx) => (
        <div class={`reveal-on-scroll delay-${(idx + 1) * 100} bg-white rounded-2xl p-6 sm:p-7 border border-stone-200 hover:border-forest/40 hover-lift transition-all duration-300 flex flex-col justify-between space-y-4`}>
          <div class="space-y-3">
            <span class="font-mono text-xs font-bold text-forest bg-forest/10 px-2.5 py-1 rounded inline-block">
              Step {s.step}
            </span>
            <h3 class="text-base font-bold text-stone-900">
              {s.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {s.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
