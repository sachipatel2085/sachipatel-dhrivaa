---
import { ArrowRight, Info, CheckCircle2, ShieldCheck } from 'lucide-react';

const comparisonData = [
  {
    name: 'Rapeseed Meal',
    slug: 'rapeseed-meal',
    category: 'Protein Meal / Feed Constituent',
    primaryUse: 'Livestock, dairy cattle, and poultry feed formulation',
    keyParameter: '36.0% – 38.0% Crude Protein (Dry Basis)',
    moistureLimit: '10.0% max (Summer transit safe)',
    physicalForm: 'Coarse ground meal / granular / pellets',
    exportPackaging: '50 kg PP bags / 1 MT Jumbo bags / Bulk in 20ft container',
    loadingPorts: 'Mundra & Kandla Ports, Gujarat',
    typicalIncoterms: 'FOB India / CFR or CIF Gulf Seaports',
    link: '/products/rapeseed-meal'
  },
  {
    name: 'Castorseed Meal',
    slug: 'castorseed-meal',
    category: 'Organic Bio-Fertilizer / Soil Amendment',
    primaryUse: 'Soil enrichment, date palms, golf turf & nematicide deterrent',
    keyParameter: '4.0% – 5.5% Organic Nitrogen (N) + NPK',
    moistureLimit: '10.0% – 12.0% max (Moisture barrier bags)',
    physicalForm: 'Granular meal / coarse powder / extruded pellets',
    exportPackaging: '50 kg PP woven bags / 1,000 kg Jumbo bags',
    loadingPorts: 'Mundra & Kandla Ports, Gujarat',
    typicalIncoterms: 'FOB India / CFR or CIF Gulf Seaports',
    link: '/products/castorseed-meal'
  },
  {
    name: 'Castor Oil (FSG / Commercial)',
    slug: 'castor-oil',
    category: 'Industrial Vegetable Oil / Oleochemical',
    primaryUse: 'Polyurethanes, lubricants, aviation greases, resins, coatings',
    keyParameter: '85.0% – 90.0% Ricinoleic Acid (Acid Value <= 2.0 FSG)',
    moistureLimit: '0.25% max (Refined First Special Grade)',
    physicalForm: 'Clear, pale golden viscous liquid',
    exportPackaging: '24,000L Flexitanks / 200L Steel Drums / 1000L IBCs',
    loadingPorts: 'Mundra & Kandla Ports, Gujarat',
    typicalIncoterms: 'FOB India / CFR or CIF International Seaports',
    link: '/products/castor-oil'
  }
];
---

<section class="py-20 lg:py-28 bg-surface-light border-b border-slate-200 relative overflow-hidden" aria-labelledby="specs-comparison-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="max-w-2xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-[0.22em] text-teal font-heading">
          Technical Benchmarks
        </span>
        <h2 id="specs-comparison-heading" class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-navy-900 tracking-tight leading-tight">
          Product Specifications <br />
          <span class="font-serif italic font-normal text-gold">at a Glance.</span>
        </h2>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          Comparative technical overview of commodities sourced across Gujarat’s crushing and solvent extraction corridors.
        </p>
      </div>

      <div class="flex-shrink-0">
        <a
          href="/buyer-resources#specifications-guide"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white hover:bg-slate-100 text-navy-950 border border-slate-200 font-heading font-bold text-xs uppercase tracking-wider transition-colors shadow-sm"
        >
          <span>Specifications Guide</span>
          <ArrowRight className="w-3.5 h-3.5 text-teal" />
        </a>
      </div>
    </div>

    <!-- Mandatory Specifications Disclaimer Box -->
    <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-amber-50/90 border border-amber-200 text-xs sm:text-sm text-amber-950 flex items-start gap-3">
      <Info className="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" />
      <p class="leading-relaxed">
        <strong>Procurement Notice:</strong> Data below represents typical commercial benchmark parameters. DHRIVAA coordinates bespoke batch specifications according to buyer contracts. An authentic, lot-specific Certificate of Analysis (COA) is issued by accredited testing laboratories prior to vessel loading.
      </p>
    </div>

    <!-- Responsive Comparison Table Container -->
    <div class="overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-card">
      <table class="w-full text-left text-sm text-slate-700 min-w-[760px]">
        <thead class="bg-navy-900 text-white text-xs uppercase tracking-wider font-heading">
          <tr>
            <th scope="col" class="py-4 px-6 w-1/4">Commodity</th>
            <th scope="col" class="py-4 px-6">Primary Active Benchmark</th>
            <th scope="col" class="py-4 px-6">Moisture Limit</th>
            <th scope="col" class="py-4 px-6">Export Packaging</th>
            <th scope="col" class="py-4 px-6 text-right">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {comparisonData.map((item, idx) => (
            <tr class="hover:bg-slate-50/80 transition-colors">
              <!-- Commodity Name & Category -->
              <td class="py-5 px-6 align-top">
                <a href={item.link} class="group inline-block">
                  <h3 class="font-heading font-bold text-base text-navy-900 group-hover:text-teal transition-colors flex items-center gap-1.5">
                    <span>{item.name}</span>
                    <ArrowRight className="w-3.5 h-3.5 text-slate-400 group-hover:text-gold opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1" />
                  </h3>
                  <span class="text-xs text-slate-500 block mt-0.5">{item.category}</span>
                </a>
                <p class="text-xs text-slate-600 mt-2 font-normal leading-relaxed">
                  {item.primaryUse}
                </p>
              </td>

              <!-- Key Benchmark Parameter -->
              <td class="py-5 px-6 align-top">
                <span class="inline-block px-3 py-1 rounded-lg bg-teal/10 text-teal-dark font-mono text-xs font-bold border border-teal/20 mb-1">
                  {item.keyParameter}
                </span>
                <span class="text-xs text-slate-500 block">Form: {item.physicalForm}</span>
              </td>

              <!-- Moisture Limit -->
              <td class="py-5 px-6 align-top">
                <span class="font-semibold text-navy-900 block text-xs sm:text-sm">
                  {item.moistureLimit}
                </span>
                <span class="text-xs text-slate-500 block mt-0.5">Ports: {item.loadingPorts}</span>
              </td>

              <!-- Packaging Formats -->
              <td class="py-5 px-6 align-top text-xs leading-relaxed text-slate-600">
                <p class="font-medium text-slate-800">{item.exportPackaging}</p>
                <span class="text-[11px] text-slate-400 mt-1 block">Terms: {item.typicalIncoterms}</span>
              </td>

              <!-- Action Link -->
              <td class="py-5 px-6 align-top text-right">
                <a
                  href={item.link}
                  class="inline-flex items-center gap-1 px-4 py-2 rounded-xl bg-slate-100 hover:bg-gold hover:text-navy-950 text-navy-900 text-xs font-heading font-bold uppercase tracking-wider transition-colors"
                >
                  <span>Specs</span>
                  <ArrowRight className="w-3 h-3" />
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Bottom Action Ribbon -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <ShieldCheck className="w-4 h-4 text-teal" />
        <span>Independent laboratory sampling (SGS / Bureau Veritas) coordinated on request.</span>
      </div>
      <a
        href="/contact"
        class="text-teal font-heading font-bold uppercase tracking-wider hover:text-gold transition-colors inline-flex items-center gap-1"
      >
        <span>Request Custom Batch Specifications &amp; Pricing</span>
        &rarr;
      </a>
    </div>

  </div>
</section>
