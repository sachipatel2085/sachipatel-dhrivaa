---
import { ArrowRight } from 'lucide-react';
---

<section class="relative bg-stone-50 py-16 sm:py-20 lg:py-28 overflow-hidden" aria-label="Hero">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Left Content (7 cols) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-left animate-fade-up">
        
        <!-- Subtle Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-100 border border-stone-200 text-stone-700 text-xs font-medium tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-forest"></span>
          <span>Agricultural Commodity Procurement &bull; Gujarat, India</span>
        </div>

        <!-- Exact Requested Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-stone-900 tracking-tight leading-[1.15] text-balance">
          Indian Agricultural Commodities. <span class="font-editorial font-normal italic text-forest">Sourced for Global Markets.</span>
        </h1>

        <!-- Short Business Introduction -->
        <p class="text-base sm:text-lg text-stone-600 max-w-xl leading-relaxed">
          DHRIVAA coordinates procurement, pre-shipment quality testing, and port logistics for verified Indian agricultural commodities, connecting international buyers with dependable extraction units across western India.
        </p>

        <!-- Buttons: Explore Products & Request a Quote -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
          <a
            href="/products"
            class="btn-forest inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide shadow-subtle hover:shadow-sm"
          >
            <span>Explore Products</span>
            <ArrowRight className="w-4 h-4" />
          </a>

          <a
            href="/contact"
            class="btn-outline inline-flex items-center justify-center px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide"
          >
            <span>Request a Quote</span>
          </a>
        </div>

        <!-- Minimal Trust Badges -->
        <div class="pt-4 border-t border-stone-200/80 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-stone-500 font-medium">
          <span>Direct Mill Coordination</span>
          <span class="text-stone-300">&bull;</span>
          <span>Mundra &amp; Kandla Ports</span>
          <span class="text-stone-300">&bull;</span>
          <span>Verified Specifications</span>
        </div>

      </div>

      <!-- Right Image: High-Quality Maritime Port & Sourcing Photo (5 cols) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl overflow-hidden border border-stone-200 shadow-card bg-stone-100 group">
          <img
            src="/images/hero-port.jpg"
            alt="Commercial cargo vessel and export terminal infrastructure in Gujarat India"
            class="w-full aspect-[4/3] lg:aspect-[5/4] object-cover object-center transform transition-transform duration-700 ease-out group-hover:scale-103"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-stone-200 text-[11px] text-stone-700 font-medium shadow-subtle">
            Western India Export Gateway &bull; Mundra &amp; Kandla
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
