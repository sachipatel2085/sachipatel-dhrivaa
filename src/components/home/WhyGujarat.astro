---
import { Anchor, Clock, ShieldCheck, MapPin, Gauge, Award, ArrowRight } from 'lucide-react';

const gujaratAdvantages = [
  {
    icon: Anchor,
    title: 'World-Class Seaports: Mundra & Kandla',
    metric: 'Shortest Ocean Route',
    description: 'Gujarat hosts India’s premier commercial deep-water maritime gateways. Both Mundra and Kandla offer state-of-the-art container terminal infrastructure, rapid vessel turnaround, and frequent liner sailings.'
  },
  {
    icon: Clock,
    title: '3 to 5 Days Direct Sailing to UAE',
    metric: '3–5 Day Transit',
    description: 'Direct container vessels connect Mundra and Kandla to Jebel Ali (Dubai) in just 3 to 5 days, and Dammam, Sohar, and Hamad in 5 to 8 days, slashing working capital cycles and ocean transit risks.'
  },
  {
    icon: Award,
    title: 'The World’s Castor Epicenter (70%+)',
    metric: '70%+ Global Share',
    description: 'Gujarat is the undisputed global hub for castor seed cultivation and refining. Sourcing directly through Gujarat gives international buyers unmatched continuous volume and competitive primary mill pricing.'
  },
  {
    icon: Gauge,
    title: 'Dense Solvent Extraction Network',
    metric: 'High Capacity',
    description: 'Western India features a dense corridor of solvent extraction plants processing non-GMO Indian rapeseed, ensuring year-round product availability and flexible protein batch customization.'
  },
  {
    icon: ShieldCheck,
    title: 'Port-Proximate Accredited Testing',
    metric: 'ISO/IEC 17025',
    description: 'World-renowned surveyor and testing laboratories (SGS, Bureau Veritas, Intertek, Geo-Chem) operate dedicated testing centers near Gujarat ports for swift pre-shipment COA verification.'
  },
  {
    icon: MapPin,
    title: 'Minimal Inland Haulage Transit',
    metric: 'Fresh Cargo',
    description: 'Processing mills in Gujarat are situated directly along national express corridors leading to the coast, reducing overland road transit times and preserving cargo freshness before container stuffing.'
  }
];
---

<section class="py-20 lg:py-28 bg-surface-light border-b border-slate-200 relative overflow-hidden" aria-labelledby="why-gujarat-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="text-xs font-bold uppercase tracking-[0.22em] text-teal font-heading">
        Strategic Sourcing Gateway
      </span>
      <h2 id="why-gujarat-heading" class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-navy-900 tracking-tight leading-tight">
        Why Source from <br />
        <span class="font-serif italic font-normal text-gold">Gujarat, India?</span>
      </h2>
      <p class="text-base text-slate-600 leading-relaxed font-normal">
        Situated on India's western maritime frontier, Gujarat provides international agricultural commodity buyers with decisive logistical and processing advantages over alternative global origins.
      </p>
    </div>

    <!-- Advantages Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {gujaratAdvantages.map((adv) => {
        const Icon = adv.icon;
        return (
          <div class="bg-white p-7 sm:p-8 rounded-2xl border border-slate-200 shadow-card hover:shadow-premium transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-navy-900/90 text-gold flex items-center justify-center group-hover:bg-teal group-hover:text-white transition-colors">
                  <Icon className="w-6 h-6" />
                </div>
                <span class="text-xs font-mono font-bold text-teal bg-teal/10 px-2.5 py-1 rounded-full border border-teal/20">
                  {adv.metric}
                </span>
              </div>

              <div>
                <h3 class="font-heading font-bold text-lg sm:text-xl text-navy-900 group-hover:text-teal transition-colors">
                  {adv.title}
                </h3>
              </div>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {adv.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Strategic Corridor Callout Strip -->
    <div class="mt-14 p-8 rounded-3xl bg-navy-950 text-white border border-navy-800 shadow-xl relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-gradient-to-l from-teal/10 to-transparent pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center relative z-10">
        <div class="lg:col-span-8 space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-gold font-heading">
            Maritime Fast-Track to the GCC
          </span>
          <h3 class="font-heading font-bold text-xl sm:text-2xl text-white">
            Direct Port Operations at Mundra &amp; Kandla
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed max-w-2xl font-normal">
            DHRIVAA’s on-the-ground operational presence in Gujarat guarantees swift coordination between local mills, container freight stations, and vessel loading agents.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-end">
          <a
            href="/insights/navigating-agricultural-sourcing-india-uae"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-xs uppercase tracking-wider transition-colors text-center"
          >
            <span>Read Trade Corridor Analysis</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
          <a
            href="/buyer-resources#incoterms-explained"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-navy-900 hover:bg-navy-850 text-slate-200 border border-slate-700 font-heading font-semibold text-xs tracking-wider transition-colors text-center"
          >
            <span>Review Shipping Terms</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
