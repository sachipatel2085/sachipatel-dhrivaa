---
import { Anchor, Clock, ShieldCheck, MapPin, Gauge, Award, ArrowRight } from 'lucide-react';

const gujaratAdvantages = [
  {
    icon: Anchor,
    title: 'World-Class Seaports: Mundra & Kandla',
    metric: 'Shortest Ocean Route',
    description: 'Premier deep-water ports offering modern container infrastructure, rapid turnaround, and regular global liner sailings.'
  },
  {
    icon: Clock,
    title: 'Fast Transit to Global Seaports',
    metric: 'Fast Transit',
    description: 'Direct sailing connects Gujarat to Gulf ports in 3 to 7 days, with established routes to Australia, Europe, and the Americas.'
  },
  {
    icon: Award,
    title: 'Global Castor Epicenter (70%+)',
    metric: '70%+ Global Share',
    description: 'Gujarat produces over 70% of the world’s castor crop, providing steady supply and primary mill pricing.'
  },
  {
    icon: Gauge,
    title: 'Dense Extraction Network',
    metric: 'High Capacity',
    description: 'Extensive corridor of solvent extraction plants processing non-GMO Indian rapeseed and castor seeds year-round.'
  },
  {
    icon: ShieldCheck,
    title: 'Port-Proximate Accredited Testing',
    metric: 'ISO/IEC 17025',
    description: 'Accredited testing agencies (SGS, Geo-Chem) operate dedicated laboratories near Gujarat ports for swift pre-shipment COAs.'
  },
  {
    icon: MapPin,
    title: 'Minimal Inland Transit',
    metric: 'Cargo Freshness',
    description: 'Processing mills situated along express corridors minimize inland haulage times and preserve cargo quality before vessel loading.'
  }
];
---

<section class="py-20 lg:py-28 bg-surface-light border-b border-slate-200 relative overflow-hidden" aria-labelledby="why-gujarat-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
        Strategic Origin
      </span>
      <h2 id="why-gujarat-heading" class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
        Why Source from Gujarat, India
      </h2>
      <p class="text-base text-slate-600 leading-relaxed font-normal">
        Gujarat is India's agricultural export engine — home to major oilseed processing clusters, competitive mandi prices, and direct container shipping corridors to the Arabian Gulf.
      </p>
    </div>

    <!-- Advantages Grid with Staggered Scroll Reveals -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {gujaratAdvantages.map((adv, idx) => {
        const Icon = adv.icon;
        return (
          <div class={`reveal-on-scroll delay-${(idx + 1) * 75} bg-white p-7 sm:p-8 rounded-2xl border border-slate-200 shadow-card hover:shadow-premium hover-lift glow-card transition-all duration-300 flex flex-col justify-between group`}>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div class="icon-box-interactive w-12 h-12 rounded-xl bg-navy-900/90 text-gold flex items-center justify-center group-hover:bg-teal group-hover:text-white transition-colors">
                  <Icon className="w-6 h-6" />
                </div>
                <span class="text-xs font-mono font-bold text-teal bg-teal/10 px-2.5 py-1 rounded-full border border-teal/20 transition-transform duration-200 group-hover:scale-105">
                  {adv.metric}
                </span>
              </div>

              <div>
                <h3 class="font-heading font-bold text-lg sm:text-xl text-navy-900 group-hover:text-teal transition-colors">
                  {adv.title}
                </h3>
              </div>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {adv.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Strategic Corridor Callout Strip with Scale Reveal -->
    <div class="reveal-scale delay-150 mt-14 p-8 rounded-3xl bg-navy-950 text-white border border-navy-800 shadow-xl relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-gradient-to-l from-teal/10 to-transparent pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center relative z-10">
        <div class="lg:col-span-8 space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-gold font-heading">
            Maritime Fast-Track to the GCC
          </span>
          <h3 class="font-heading font-bold text-xl sm:text-2xl text-white">
            Direct Port Operations at Mundra &amp; Kandla
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed max-w-2xl font-normal">
            DHRIVAA’s on-the-ground operational presence in Gujarat guarantees swift coordination between local mills, container freight stations, and vessel loading agents.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-end">
          <a
            href="/insights/navigating-agricultural-sourcing-india-uae"
            class="btn-gold-interactive group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gold hover:bg-gold-dark text-navy-950 font-heading font-bold text-xs uppercase tracking-wider text-center"
          >
            <span>Read Trade Corridor Analysis</span>
            <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </a>
          <a
            href="/buyer-resources#incoterms-explained"
            class="btn-navy-interactive group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-navy-900 hover:bg-navy-850 text-slate-200 border border-slate-700 font-heading font-semibold text-xs tracking-wider text-center"
          >
            <span>Review Shipping Terms</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
