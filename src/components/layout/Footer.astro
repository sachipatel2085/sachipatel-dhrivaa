---
import { companyData } from '../../data/company';
import { footerQuickLinks, footerProductLinks, footerResourceLinks, footerLegalLinks } from '../../data/navigation';
import { Mail, Phone, MapPin, MessageSquare, ArrowRight } from 'lucide-react';

const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-100 text-stone-700 border-t border-stone-200" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    
    <!-- Top Grid: Brand & Column Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-stone-200">
      
      <!-- Col 1: Brand Info (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-block" aria-label="DHRIVAA – Global Trade Partner">
          <img
            src="/images/logo.png"
            alt="DHRIVAA – Global Trade Partner"
            class="h-9 w-auto object-contain"
            width="984"
            height="305"
            loading="lazy"
          />
        </a>
        <p class="text-xs sm:text-sm text-stone-600 max-w-sm leading-relaxed">
          Connecting international commodity buyers with reliable Indian agricultural extraction units through transparent procurement, quality verification, and port logistics.
        </p>

        <!-- Positioning Note -->
        <p class="text-[11px] text-stone-500 italic max-w-xs leading-normal pt-1">
          *DHRIVAA is an independent sourcing and procurement coordinator based in Gujarat, India. We do not manufacture.
        </p>

        <!-- Direct WhatsApp Pill -->
        <div class="pt-1">
          <a
            href={companyData.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200 text-stone-800 text-xs font-medium hover:border-forest/50 transition-colors shadow-subtle"
          >
            <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
            <span>WhatsApp: {companyData.phoneDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-900">
          Navigation
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm" role="list">
          {footerQuickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-stone-600 hover:text-forest transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Commodities (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-900">
          Commodities
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm" role="list">
          {footerProductLinks.map((link) => (
            <li>
              <a href={link.href} class="text-stone-600 hover:text-forest transition-colors">
                {link.label}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href="/products" class="text-xs font-medium text-forest hover:underline">
              All Commodities &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Resources & Contact (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-900">
          Trade Coordination Desk
        </h3>
        <div class="space-y-2 text-xs text-stone-600">
          <p class="text-stone-900 font-medium">{companyData.location}</p>
          <p class="text-stone-500">Mundra &amp; Kandla Port Gateway</p>
          
          <div class="pt-1 space-y-1">
            <a href={`mailto:${companyData.email}`} class="block hover:text-forest transition-colors">
              {companyData.email}
            </a>
            <a href={`tel:${companyData.phone}`} class="block hover:text-forest transition-colors">
              {companyData.phoneDisplay}
            </a>
          </div>

          <div class="pt-2">
            <a href="/buyer-resources" class="text-xs font-medium text-forest hover:underline block">
              Buyer Resources &amp; Guides &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>&copy; {currentYear} {companyData.name}. All rights reserved.</p>
      
      <div class="flex items-center space-x-6">
        {footerLegalLinks.map((link) => (
          <a href={link.href} class="hover:text-stone-800 transition-colors">
            {link.label}
          </a>
        ))}
        <a href="#top" class="hover:text-forest transition-colors">
          Back to Top &uarr;
        </a>
      </div>
    </div>

  </div>
</footer>
