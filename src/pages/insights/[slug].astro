---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { insightsData, type ArticleItem } from '../../data/insights';
import { companyData } from '../../data/company';
import { 
  Calendar, 
  Clock, 
  ArrowLeft, 
  ArrowRight, 
  Share2, 
  ShieldCheck, 
  CheckCircle2, 
  Building, 
  FileText, 
  Tag 
} from 'lucide-react';

export function getStaticPaths() {
  return insightsData.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ArticleItem;
}

const { article } = Astro.props;

// Article Schema JSON-LD
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  image: `https://dhrivaa.com${article.image}`,
  datePublished: article.publishDate,
  dateModified: article.updatedDate,
  author: {
    '@type': 'Organization',
    name: article.author.name,
    url: 'https://dhrivaa.com'
  },
  publisher: {
    '@type': 'Organization',
    name: companyData.name,
    logo: {
      '@type': 'ImageObject',
      url: 'https://dhrivaa.com/images/logo.png'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://dhrivaa.com/insights/${article.slug}`
  }
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://dhrivaa.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Trade Insights',
      item: 'https://dhrivaa.com/insights'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: `https://dhrivaa.com/insights/${article.slug}`
    }
  ]
};

const finalJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [articleJsonLd, breadcrumbJsonLd]
};
---

<BaseLayout 
  title={`${article.title} | DHRIVAA Insights`} 
  description={article.seo.description}
  keywords={article.seo.keywords}
  jsonLd={finalJsonLd}
>
  
  <!-- Article Header & Breadcrumbs Area -->
  <header class="bg-navy-950 text-white pt-28 pb-16 lg:pb-20 relative overflow-hidden" aria-label="Article Header">
    <!-- Subtle background ambient grid -->
    <div class="absolute inset-0 bg-[radial-gradient(#193F66_1px,transparent_1px)] [background-size:24px_24px] opacity-25 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <a href="/insights" class="hover:text-gold transition-colors">Trade Insights</a>
        <span class="text-slate-600">/</span>
        <span class="text-teal font-medium truncate max-w-[200px] sm:max-w-none">{article.title}</span>
      </nav>

      <!-- Category & Meta -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <span class="px-3.5 py-1 rounded-full bg-teal/20 text-teal-light border border-teal/30 text-xs font-heading font-bold uppercase tracking-wider">
          {article.category}
        </span>
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <Calendar className="w-3.5 h-3.5 text-gold" />
          <time datetime={article.publishDate}>Published {article.publishDate}</time>
        </span>
        <span class="text-slate-600">&bull;</span>
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <Clock className="w-3.5 h-3.5 text-gold" />
          <span>{article.readTime}</span>
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight text-balance">
        {article.title}
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
        {article.subtitle}
      </p>

      <!-- Author Byline Bar -->
      <div class="flex items-center justify-between pt-6 border-t border-navy-850">
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-full bg-navy-900 border border-gold/40 flex items-center justify-center text-gold font-heading font-bold text-sm">
            DH
          </div>
          <div>
            <span class="text-xs font-bold text-white block">{article.author.name}</span>
            <span class="text-[11px] text-slate-400">{article.author.role}</span>
          </div>
        </div>

        <a
          href="/insights"
          class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-gold transition-colors font-medium"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>All Briefings</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Article Main Body -->
  <main class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Featured Image Container -->
      <div class="rounded-3xl overflow-hidden shadow-card border border-slate-200 bg-navy-950 aspect-[16/9]">
        <img
          src={article.image}
          alt={article.alt}
          class="w-full h-full object-cover filter brightness-[0.98]"
          loading="eager"
        />
      </div>

      <!-- Key Takeaways Executive Summary Box -->
      <section class="p-7 sm:p-8 rounded-3xl bg-surface-light border border-slate-200/90 shadow-subtle space-y-4" aria-label="Executive Key Takeaways">
        <div class="flex items-center gap-2.5 text-navy-900 font-heading font-bold text-base">
          <ShieldCheck className="w-5 h-5 text-teal" />
          <span>Executive Summary &amp; Key Takeaways</span>
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed" role="list">
          {article.keyTakeaways.map((takeaway) => (
            <li class="flex items-start gap-3">
              <CheckCircle2 className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
              <span>{takeaway}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Editorial Content Sections -->
      <div class="prose prose-slate max-w-none space-y-10">
        {article.content.map((sec) => (
          <section class="space-y-4">
            <h2 class="font-heading font-bold text-xl sm:text-2xl text-navy-900 tracking-tight pt-2">
              {sec.heading}
            </h2>

            {sec.body.map((p) => (
              <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
                {p}
              </p>
            ))}

            {sec.callout && (
              <blockquote class="my-6 p-5 rounded-2xl bg-slate-50 border-l-4 border-gold text-slate-800 text-sm font-medium italic leading-relaxed">
                "{sec.callout}"
              </blockquote>
            )}

            {sec.table && (
              <div class="my-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-subtle">
                <table class="w-full text-left text-xs sm:text-sm text-slate-700 min-w-[560px]">
                  <thead class="bg-navy-900 text-white text-xs uppercase tracking-wider font-heading">
                    <tr>
                      {sec.table.headers.map((h) => (
                        <th scope="col" class="py-3 px-4 sm:px-6">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200">
                    {sec.table.rows.map((row, rIdx) => (
                      <tr class={rIdx % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                        {row.map((cell, cIdx) => (
                          <td class={`py-3 px-4 sm:px-6 ${cIdx === 0 ? 'font-semibold text-navy-900' : 'text-slate-600'}`}>
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))}
      </div>

      <!-- Contextual Internal Linking: Related Commodities -->
      <section class="pt-10 border-t border-slate-200 space-y-6">
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-teal font-heading">
            Related Commodities
          </span>
          <h3 class="font-heading font-bold text-xl text-navy-900">
            Sourced Products Mentioned in this Report
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {article.relatedProducts.map((p) => (
            <div class="p-6 rounded-2xl bg-surface-light border border-slate-200 flex flex-col justify-between space-y-3">
              <div>
                <h4 class="font-heading font-bold text-base text-navy-900">
                  {p.name}
                </h4>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  {p.description}
                </p>
              </div>
              <a
                href={`/products/${p.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-heading font-bold text-teal hover:text-gold uppercase tracking-wider transition-colors pt-2"
              >
                <span>View Specifications</span>
                <ArrowRight className="w-3 h-3" />
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- Author Bio & Trade Integrity Notice -->
      <section class="p-7 rounded-2xl bg-navy-950 text-white space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gold/20 text-gold flex items-center justify-center font-bold text-xs">
            DHR
          </div>
          <div>
            <h4 class="font-heading font-bold text-sm text-white">About the Author: {article.author.name}</h4>
            <p class="text-xs text-slate-400">Agricultural Sourcing Coordination Desk &bull; Gujarat, India</p>
          </div>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          DHRIVAA provides independent commodity sourcing, supplier auditing, sample coordination, and export documentation for buyers in the UAE and Middle East. We operate strictly as an independent procurement coordinator, never a manufacturer.
        </p>
      </section>

      <!-- Back to All Insights -->
      <div class="text-center pt-4">
        <a
          href="/insights"
          class="inline-flex items-center gap-2 text-xs font-heading font-bold text-navy-900 hover:text-teal uppercase tracking-widest transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Return to All Trade Insights</span>
        </a>
      </div>

    </div>
  </main>

  <!-- Final CTA -->
  <FinalCTA />
</BaseLayout>
