---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { companyData } from '../data/company';
import { ShieldCheck, Microscope, FileCheck, CheckCircle2, AlertCircle, ArrowRight, Eye, Scale } from 'lucide-react';

const pageTitle = `Quality Assurance & Coordination | ${companyData.name}`;
const pageDescription = 'Learn how DHRIVAA coordinates quality control, pre-shipment laboratory analysis, sample dispatch, and export compliance documentation for international buyers.';

const qualityStages = [
  {
    step: '01',
    title: 'Product Specifications Review',
    desc: 'Reviewing and detailing required buyer specifications against technical feasibility with regional processors.'
  },
  {
    step: '02',
    title: 'Sample Coordination',
    desc: 'Dispatching representative factory samples via air express for preliminary evaluation by buyer laboratory teams.'
  },
  {
    step: '03',
    title: 'Documentation Support',
    desc: 'Coordinating batch-level Certificate of Analysis (COA), Phytosanitary Certificates, and Certificate of Origin.'
  },
  {
    step: '04',
    title: 'Packaging & Stuffing Verification',
    desc: 'Supervising container stuffing, bag integrity, liner installation, and container cleanliness standards.'
  },
  {
    step: '05',
    title: 'Pre-Shipment Inspection (Third-Party)',
    desc: 'Facilitating independent inspection agencies (e.g., SGS, Bureau Veritas) at port of loading upon buyer request.'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Cinematic Hero Header with Dark Gradient Overlay & Laboratory Banner -->
  <PageHero
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Quality Assurance' }
    ]}
    eyebrow="OBJECTIVE OVERSIGHT & CONTRACT INTEGRITY"
    title="Quality Assurance."
    titleAccent="Verified at Every Sourcing Stage."
    description="We support quality coordination and documentation based on buyer requirements and supplier availability. Our objective is to ensure transparency and contract fidelity from factory gate to ocean container."
    bannerImage="/images/step-quality.jpg"
    bannerAlt="Agricultural quality assurance laboratory with optical microscope and seed analysis glassware"
    primaryButton={{
      label: 'Enquire About Inspection Protocols',
      href: '/contact'
    }}
    secondaryButton={{
      label: 'Browse Commodities',
      href: '/products'
    }}
    trustTags={[
      { text: 'Batch COA Verification', color: 'teal' },
      { text: 'Third-Party Surveyors (SGS/BV)', color: 'gold' },
      { text: 'Phytosanitary Certification', color: 'slate' }
    ]}
  />

  <!-- Compliance & Honest Stance Notice -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-600 flex items-start gap-4">
        <ShieldCheck className="w-5 h-5 text-teal flex-shrink-0 mt-0.5" />
        <div class="space-y-1">
          <h3 class="font-bold text-sm text-navy-900">
            Independent Quality Coordination Policy
          </h3>
          <p class="leading-relaxed">
            DHRIVAA is an independent sourcing coordinator. We do not issue unilateral private certifications or operate internal manufacturer test labs. All certificates of analysis, phytosanitary certificates, and inspection reports are issued directly by accredited third-party laboratories and government authorities according to buyer contract stipulations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Quality Coordination Stages -->
  <section class="py-16 lg:py-24 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Systematic Verification
        </span>
        <h2 class="font-heading font-extrabold text-3xl text-navy-900 tracking-tight">
          Our Quality Coordination Framework
        </h2>
        <p class="text-sm text-slate-600">
          How we safeguard contract parameters throughout the procurement lifecycle.
        </p>
      </div>

      <div class="space-y-6">
        {qualityStages.map((stage) => (
          <div class="bg-white p-7 rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card transition-all flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-start gap-5">
              <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold font-heading font-extrabold text-base flex items-center justify-center flex-shrink-0">
                {stage.step}
              </div>
              <div class="space-y-1">
                <h3 class="font-heading font-bold text-lg text-navy-900">
                  {stage.title}
                </h3>
                <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
                  {stage.desc}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2 text-xs font-semibold text-teal self-start md:self-auto flex-shrink-0">
              <CheckCircle2 className="w-4 h-4" />
              <span>Standard Operational Step</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Pre-Shipment Inspection Agency Coordination -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
            Third-Party Verification
          </span>
          <h2 class="font-heading font-extrabold text-3xl text-navy-900 tracking-tight leading-tight">
            Independent Surveyor Oversight at Loading Ports
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            To provide foreign buyers with full peace of mind, we welcome and coordinate pre-shipment inspection services at Mundra Port and Kandla Port. Buyers may appoint their preferred international survey company:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
              <p class="font-bold text-navy-900">Weight &amp; Quantity Survey</p>
              <p class="text-slate-500">Gross/tare weighbridge verification and bag count certification.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
              <p class="font-bold text-navy-900">Sampling &amp; Lab Sealing</p>
              <p class="text-slate-500">Composite sampling per ISO standards and tamper-proof sample sealing.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
              <p class="font-bold text-navy-900">Container Cleanliness</p>
              <p class="text-slate-500">Inspection of marine containers for odor, moisture, and structural integrity.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
              <p class="font-bold text-navy-900">Stuffing &amp; Bottle Seal</p>
              <p class="text-slate-500">High-resolution photographic documentation of container stuffing and seal numbers.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-card">
            <img
              src="/images/step-logistics.jpg"
              alt="Containerized cargo loading and marine vessel logistics"
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />

</BaseLayout>
