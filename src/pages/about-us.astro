---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { companyData } from '../data/company';
import { ShieldCheck, Compass, CheckCircle2, ArrowRight } from 'lucide-react';

const pageTitle = `About Us | ${companyData.name} – Global Trade Partner`;
const pageDescription = 'Learn about DHRIVAA, a Gujarat-based agricultural commodity sourcing and procurement partner connecting international buyers with verified Indian extraction units and suppliers.';

const pillars = [
  {
    title: 'Buyer Focused',
    desc: 'We structure every procurement mandate around your exact target specifications, packaging needs, and shipping schedule.'
  },
  {
    title: 'Transparent Process',
    desc: 'Clear communication at every stage—from supplier identification and lot pricing to pre-shipment inspection and dispatch.'
  },
  {
    title: 'Quality Coordination',
    desc: 'Independent coordination for laboratory testing, Certificate of Analysis (COA) verification, and container stuffing.'
  },
  {
    title: 'Long-Term Partnerships',
    desc: 'Cultivating sustainable, repeat trading relationships built on consistent execution, market honesty, and mutual trust.'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Cinematic Hero Header with Dark Gradient Overlay & Topic Banner -->
  <PageHero
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'About Us' }
    ]}
    eyebrow="CORPORATE PROFILE & SOURCING PHILOSOPHY"
    title="About DHRIVAA."
    titleAccent="Rooted in Gujarat, Connecting to Global Markets."
    description="DHRIVAA is a Gujarat, India-based agricultural commodity sourcing and procurement company. We connect international buyers with reliable suppliers in India, focusing on quality, transparency, and long-term trade relationships."
    bannerImage="/images/banner-about.jpg"
    bannerAlt="Modern agricultural commodity processing silos and export infrastructure in Gujarat India at sunset"
    primaryButton={{
      label: 'Our Sourcing Approach',
      href: '#approach'
    }}
    secondaryButton={{
      label: 'Contact Procurement Desk',
      href: '/contact'
    }}
    trustTags={[
      { text: 'Gujarat Sourcing Hub', color: 'teal' },
      { text: 'Direct Mill Coordination', color: 'gold' },
      { text: 'Mundra & Kandla Ports', color: 'slate' }
    ]}
  />

  <!-- Business Positioning Statement (Strict Compliance) -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200/90 flex flex-col md:flex-row items-start md:items-center gap-6">
        <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
          <ShieldCheck className="w-6 h-6" />
        </div>
        <div class="space-y-1 flex-grow">
          <h3 class="font-heading font-bold text-base text-navy-900">
            Transparent Business Positioning
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            DHRIVAA operates strictly as a specialized sourcing, quality coordination, and procurement partner. We do not manufacture products or claim ownership of processing mills. Instead, we act with fiduciary independence on behalf of international buyers to source from audited Indian suppliers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Core Pillars -->
  <section id="approach" class="py-20 bg-surface-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Our Operational Tenets
        </span>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight">
          Built on Predictability and Trust
        </h2>
        <p class="text-base text-slate-600">
          We bridge the gap between overseas commodity specifications and Indian agricultural producers.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {pillars.map((pillar, i) => (
          <div class="bg-white p-7 rounded-2xl border border-slate-200/80 shadow-subtle hover:shadow-card transition-all space-y-4">
            <span class="font-mono text-xs font-bold text-gold bg-gold/10 px-2.5 py-1 rounded">
              0{i + 1}
            </span>
            <h3 class="font-heading font-bold text-lg text-navy-900">
              {pillar.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Strategic Advantage of Gujarat -->
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
            Sourcing Epicentre
          </span>
          <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-navy-900 tracking-tight leading-tight">
            Why Gujarat is the Ideal Commodity Gateway
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            Gujarat represents India's leading maritime and agricultural processing state. Home to the country's deepest draft ports and the central cultivation belts for oilseeds, sourcing through Gujarat delivers substantial operational advantages:
          </p>

          <ul class="space-y-3 text-sm text-slate-700" role="list">
            <li class="flex items-start gap-3">
              <CheckCircle2 className="w-5 h-5 text-teal flex-shrink-0 mt-0.5" />
              <span>Direct access to Mundra &amp; Kandla container terminals offering rapid maritime transit to Arabian Gulf ports (Jebel Ali, Dammam, Sohar).</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle2 className="w-5 h-5 text-teal flex-shrink-0 mt-0.5" />
              <span>Epicentre of the Indian castor economy, producing over 70% of the world's castor seed harvest and meal by-products.</span>
            </li>
            <li class="flex items-start gap-3">
              <CheckCircle2 className="w-5 h-5 text-teal flex-shrink-0 mt-0.5" />
              <span>Extensive clusters of modern solvent extraction plants, expeller units, and vegetable oil refining facilities.</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-card">
            <img
              src="/images/step-suppliers.jpg"
              alt="Agricultural sourcing storage facilities and logistics in Gujarat India"
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA />

</BaseLayout>
