---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyData } from '../data/company';
import { ShieldCheck, CheckCircle2, ArrowRight, Anchor, FileText, Compass, MapPin } from 'lucide-react';

const pageTitle = `About Us | ${companyData.name} – Global Trade Partner`;
const pageDescription = 'Learn about DHRIVAA, an independent agricultural commodity sourcing and procurement coordinator based in Gujarat, India connecting global buyers with verified extraction units.';

const coreCommodities = [
  {
    name: 'Rapeseed Meal',
    role: 'Animal Nutrition & Ruminant Feed',
    desc: 'High-protein agricultural by-product extracted from Brassica napus processing, sourced across vetted solvent extraction units in western India.',
    href: '/products/rapeseed-meal'
  },
  {
    name: 'Castorseed Meal',
    role: 'Organic Fertilizer & Soil Conditioning',
    desc: 'Nutrient-dense organic de-oiled meal naturally rich in nitrogen, phosphorus, and potassium for commercial organic agriculture.',
    href: '/products/castorseed-meal'
  },
  {
    name: 'Castor Oil',
    role: 'Industrial & Technical Formulations',
    desc: 'Commercial and technical grade vegetable oil for industrial manufacturing, lubricants, and chemical derivatives.',
    href: '/products/castor-oil'
  }
];

const sourcingPrinciples = [
  {
    title: 'Buyer-Led Specifications',
    desc: 'We do not trade speculative stock. Every procurement mandate is initiated by buyer parameters for protein, moisture, packaging, and volume.'
  },
  {
    title: 'Direct Mill Coordination',
    desc: 'Direct access to established crushing plants in Gujarat, eliminating layers of brokers and ensuring authentic lot traceability.'
  },
  {
    title: 'Pre-Shipment Testing',
    desc: 'Coordination with independent certified laboratories (SGS, Geo-Chem) to issue Certificates of Analysis (COA) matching contract specifications.'
  },
  {
    title: 'Port Logistics Execution',
    desc: 'Supervision of container stuffing, moisture barrier lining, and export customs clearance at Mundra and Deendayal (Kandla) ports.'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Header / Breadcrumb -->
  <section class="bg-stone-50 py-12 sm:py-16 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span class="text-stone-300">/</span>
        <span class="text-stone-900 font-medium">About Us</span>
      </nav>

      <span class="text-xs font-semibold uppercase tracking-widest text-forest block">
        Company Overview
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight leading-tight">
        Connecting Global Buyers with <span class="font-editorial font-normal italic text-forest">Indian Agricultural Sources</span>
      </h1>
      <p class="text-stone-600 text-base sm:text-lg max-w-2xl leading-relaxed">
        DHRIVAA is an independent sourcing and procurement coordinator based in Gujarat, India, specializing in verified agricultural by-products and vegetable oils.
      </p>
    </div>
  </section>

  <!-- Business Model & Transparent Positioning -->
  <section class="py-16 sm:py-20 bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
            Our Business Model
          </h2>
          <div class="space-y-4 text-stone-600 text-sm sm:text-base leading-relaxed">
            <p>
              DHRIVAA represents overseas buyers seeking reliable, contract-compliant agricultural commodities from India. We operate directly within western India's oilseed processing heartland, bridging geographical and regulatory gaps between Indian crushing facilities and international markets—particularly in the UAE and Arabian Gulf.
            </p>
            <p>
              Rather than maintaining proprietary inventory, we coordinate every shipment from verified processing facilities to match the buyer's precise grade, moisture, protein, and packaging stipulations.
            </p>
          </div>

          <!-- Strict Compliance Notice Box -->
          <div class="p-4 sm:p-5 rounded-2xl bg-stone-50 border border-stone-200 text-xs sm:text-sm text-stone-600 space-y-2 mt-6">
            <div class="flex items-center gap-2 font-semibold text-stone-900">
              <ShieldCheck className="w-4 h-4 text-forest flex-shrink-0" />
              <span>Independent Coordinator Status</span>
            </div>
            <p class="leading-relaxed text-stone-500 pl-6 text-xs">
              DHRIVAA operates as an independent sourcing and procurement coordinator. We do not manufacture commodities or own crushing mills. We represent buyers with fiduciary independence, managing supplier evaluation, pricing negotiation, and pre-shipment quality inspection.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 bg-stone-50 p-6 sm:p-7 rounded-2xl border border-stone-200 space-y-4">
          <h3 class="text-base font-bold text-stone-900 border-b border-stone-200 pb-3">
            Company Facts
          </h3>
          <dl class="space-y-3 text-xs sm:text-sm">
            <div>
              <dt class="text-stone-500 text-xs">Headquarters</dt>
              <dd class="font-medium text-stone-900 mt-0.5">Gujarat, India</dd>
            </div>
            <div>
              <dt class="text-stone-500 text-xs">Primary Shipping Ports</dt>
              <dd class="font-medium text-stone-900 mt-0.5">Mundra Port &amp; Deendayal Port (Kandla)</dd>
            </div>
            <div>
              <dt class="text-stone-500 text-xs">Key Destination Markets</dt>
              <dd class="font-medium text-stone-900 mt-0.5">UAE, Saudi Arabia, Oman, Qatar, Bahrain, Kuwait</dd>
            </div>
            <div>
              <dt class="text-stone-500 text-xs">Procurement Mode</dt>
              <dd class="font-medium text-stone-900 mt-0.5">Buyer-specific contract structuring (FCL &amp; Break-Bulk)</dd>
            </div>
          </dl>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Commodities -->
  <section class="py-16 sm:py-20 bg-stone-50 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-semibold uppercase tracking-widest text-forest">
          Portfolio
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight mt-1.5">
          Core Commodities We Coordinate
        </h2>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed mt-2">
          We focus our sourcing strictly on three high-volume agro-industrial commodities where western India holds verified global cost and volume advantages.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {coreCommodities.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200 hover:border-forest/40 hover-lift transition-all space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-[11px] font-semibold text-forest uppercase tracking-wider block">
                {item.role}
              </span>
              <h3 class="text-lg font-bold text-stone-900">
                {item.name}
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                {item.desc}
              </p>
            </div>
            <div class="pt-2">
              <a href={item.href} class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-900 hover:text-forest transition-colors">
                <span>View Specifications</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Sourcing Approach & Quality Coordination (Merged Content) -->
  <section id="approach" class="py-16 sm:py-20 bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-semibold uppercase tracking-widest text-forest">
          Sourcing &amp; Quality Approach
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight mt-1.5">
          Quality Verification &amp; Procurement Execution
        </h2>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed mt-2">
          Our operational methodology ensures that buyers receive transparent pricing, documented quality testing, and reliable port handling.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sourcingPrinciples.map((p, idx) => (
          <div class="bg-stone-50 rounded-2xl p-6 sm:p-7 border border-stone-200 space-y-3">
            <span class="font-mono text-xs font-bold text-forest bg-forest/10 px-2 py-0.5 rounded">
              0{idx + 1}
            </span>
            <h3 class="text-base font-bold text-stone-900">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {p.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Export Documentation Standards Box -->
      <div class="mt-8 p-6 rounded-2xl bg-stone-100 border border-stone-200 space-y-3">
        <h3 class="text-sm font-bold text-stone-900 flex items-center gap-2">
          <FileText className="w-4 h-4 text-forest" />
          <span>Standard Pre-Shipment Documentation Package</span>
        </h3>
        <p class="text-xs text-stone-600 leading-relaxed">
          Every export consignment coordinated through DHRIVAA is backed by verified commercial and regulatory paperwork: Certificate of Analysis (COA) issued by certified labs, Phytosanitary Certificate issued by Indian Quarantine authorities, Certificate of Origin (COO), Commercial Invoice, Packing List, and Bill of Lading.
        </p>
      </div>

    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 sm:py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
        Discuss Sourcing Requirements
      </h2>
      <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
        Speak directly with our team in Gujarat to discuss grade requirements, trial volumes, or ocean transit timelines.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/contact"
          class="btn-forest inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide"
        >
          <span>Request a Quote</span>
          <ArrowRight className="w-4 h-4" />
        </a>
        <a
          href={companyData.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline inline-flex items-center justify-center px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide"
        >
          <span>WhatsApp Trade Desk</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
