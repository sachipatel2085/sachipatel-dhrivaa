---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProductShowcase from '../components/home/ProductShowcase.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import WhyDhrivaa from '../components/home/WhyDhrivaa.astro';
import HowWeWork from '../components/home/HowWeWork.astro';
import HomeContactCTA from '../components/home/HomeContactCTA.astro';
import { companyData } from '../data/company';

const pageTitle = `${companyData.name} – Global Trade Partner | Agricultural Commodity Sourcing India`;
const pageDescription = 'Connecting global buyers with reliable agricultural commodity sources from Gujarat, India. Specializing in Rapeseed Meal, Castorseed Meal, and Castor Oil procurement.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Products Portfolio -->
  <ProductShowcase />

  <!-- 3. About DHRIVAA -->
  <AboutIntro />

  <!-- 4. Why DHRIVAA -->
  <WhyDhrivaa />

  <!-- 5. How We Work -->
  <HowWeWork />

  <!-- 6. Contact CTA -->
  <HomeContactCTA />
</BaseLayout>
