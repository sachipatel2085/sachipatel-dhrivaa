---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { productsData, type ProductItem } from '../../data/products';
import { companyData } from '../../data/company';
import {
  CheckCircle2,
  ArrowRight,
  AlertCircle,
  Package,
  MessageSquare,
  ChevronRight,
  Home
} from 'lucide-react';

export function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;

const otherProducts = productsData.filter((p) => p.slug !== product.slug);

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': `https://dhrivaa.com/products/${product.slug}#product`,
      name: product.name,
      description: product.heroDescription,
      image: `https://dhrivaa.com${product.image}`,
      category: 'Agricultural Commodity',
      brand: { '@type': 'Brand', name: 'DHRIVAA' },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: companyData.name, url: 'https://dhrivaa.com' }
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dhrivaa.com' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://dhrivaa.com/products' },
        { '@type': 'ListItem', position: 3, name: product.name, item: `https://dhrivaa.com/products/${product.slug}` }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: product.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer }
      }))
    }
  ]
};

const whatsappUrl = `https://wa.me/${companyData.phone.replace('+', '')}?text=${encodeURIComponent(
  `Hello DHRIVAA, I am interested in sourcing ${product.name}. Please share more details.`
)}`;
---

<BaseLayout
  title={product.seo.title}
  description={product.seo.description}
  keywords={product.seo.keywords}
  jsonLd={jsonLdGraph}
>

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200 pt-24 sm:pt-28 pb-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-navy-900 transition-colors inline-flex items-center gap-1">
          <Home className="w-3.5 h-3.5" />
          <span>Home</span>
        </a>
        <span class="text-slate-300">/</span>
        <a href="/products" class="hover:text-navy-900 transition-colors">Products</a>
        <span class="text-slate-300">/</span>
        <span class="text-navy-900 font-medium">{product.name}</span>
      </nav>
    </div>
  </div>

  <!-- Product Main: Image + Info -->
  <section class="bg-white py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Product Image -->
        <div class="rounded-2xl overflow-hidden bg-slate-100 aspect-[4/3] shadow-sm">
          <img
            src={product.image}
            alt={product.alt}
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>

        <!-- Product Info -->
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-teal">{product.eyebrow}</span>
            <h1 class="font-heading font-bold text-3xl sm:text-4xl text-navy-900 tracking-tight">{product.name}</h1>
            <p class="text-slate-600 text-base leading-relaxed">{product.heroDescription}</p>
          </div>

          <!-- Key Facts -->
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <span class="text-slate-400 block mb-0.5">Origin</span>
              <span class="font-semibold text-navy-900">Gujarat & Western India</span>
            </div>
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <span class="text-slate-400 block mb-0.5">Shipping Ports</span>
              <span class="font-semibold text-navy-900">Mundra & Kandla</span>
            </div>
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <span class="text-slate-400 block mb-0.5">Transit to UAE</span>
              <span class="font-semibold text-teal">3–5 Days</span>
            </div>
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-200">
              <span class="text-slate-400 block mb-0.5">Minimum Order</span>
              <span class="font-semibold text-navy-900">1 × 20ft FCL</span>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a
              href={`/contact?product=${product.slug}`}
              class="flex-1 flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-navy-900 hover:bg-navy-800 text-white font-heading font-bold text-sm tracking-wide transition-colors"
            >
              Request a Quote
              <ArrowRight className="w-4 h-4" />
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-sm tracking-wide transition-colors"
            >
              <MessageSquare className="w-4 h-4" />
              WhatsApp Inquiry
            </a>
          </div>

          <!-- Disclaimer -->
          <p class="text-xs text-slate-500 leading-relaxed border-t border-slate-100 pt-4">
            DHRIVAA is an independent sourcing and procurement coordinator. We do not manufacture. All specifications are confirmed per contract via certified COA.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Specifications -->
  <section id="specifications" class="bg-slate-50 py-10 lg:py-14 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <h2 class="font-heading font-bold text-2xl text-navy-900">Typical Specifications</h2>
        <p class="text-sm text-slate-500 mt-1">{product.specificationsNotice}</p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm bg-white">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="bg-navy-900 text-white">
              <th class="py-3 px-5 font-heading font-semibold text-xs uppercase tracking-wider">Parameter</th>
              <th class="py-3 px-5 font-heading font-semibold text-xs uppercase tracking-wider">Typical Value</th>
              <th class="py-3 px-5 font-heading font-semibold text-xs uppercase tracking-wider hidden sm:table-cell">Test Method</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {product.specifications.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                <td class="py-3 px-5 font-medium text-navy-900">{row.parameter}</td>
                <td class="py-3 px-5 font-mono text-teal font-semibold">{row.value}</td>
                <td class="py-3 px-5 text-slate-400 text-xs hidden sm:table-cell">{row.testMethod || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Applications + Packaging (side by side on desktop) -->
  <section class="bg-white py-10 lg:py-14 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Applications -->
        <div>
          <h2 class="font-heading font-bold text-2xl text-navy-900 mb-5">{product.applicationsHeading}</h2>
          <ul class="space-y-3">
            {product.applications.map((app) => (
              <li class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 bg-slate-50">
                <CheckCircle2 className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
                <div>
                  <span class="font-semibold text-navy-900 text-sm">{app.title}</span>
                  <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">{app.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Packaging -->
        <div>
          <h2 class="font-heading font-bold text-2xl text-navy-900 mb-5">Packaging Options</h2>
          <ul class="space-y-3">
            {product.packagingOptions.map((opt) => (
              <li class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 bg-slate-50">
                <Package className="w-4 h-4 text-gold flex-shrink-0 mt-0.5" />
                <div>
                  <span class="font-semibold text-navy-900 text-sm">{opt.title}</span>
                  <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">{opt.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQs -->
  {product.faqs.length > 0 && (
    <section class="bg-slate-50 py-10 lg:py-14 border-t border-slate-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading font-bold text-2xl text-navy-900 mb-6">Common Questions</h2>
        <div class="space-y-3">
          {product.faqs.map((faq) => (
            <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none">
                <span class="font-semibold text-sm text-navy-900">{faq.question}</span>
                <ChevronRight className="w-4 h-4 text-slate-400 flex-shrink-0 group-open:rotate-90 transition-transform" />
              </summary>
              <div class="px-5 pb-4 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other Products -->
  <section class="bg-white py-10 lg:py-14 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-heading font-bold text-xl text-navy-900">Other Products</h2>
        <a href="/products" class="text-xs font-semibold text-teal hover:underline inline-flex items-center gap-1">
          View All <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {otherProducts.map((p) => (
          <a
            href={`/products/${p.slug}`}
            class="group flex gap-4 items-center p-4 rounded-xl border border-slate-200 hover:border-slate-300 hover:shadow-sm bg-white transition-all"
          >
            <div class="w-20 h-20 rounded-lg overflow-hidden bg-slate-100 flex-shrink-0">
              <img src={p.image} alt={p.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="font-heading font-semibold text-sm text-navy-900 group-hover:text-teal transition-colors">{p.name}</h3>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">{p.shortDescription}</p>
            </div>
            <ChevronRight className="w-4 h-4 text-slate-300 group-hover:text-teal flex-shrink-0 transition-colors" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>
