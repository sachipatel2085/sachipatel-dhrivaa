---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { productsData, type ProductItem } from '../../data/products';
import { companyData } from '../../data/company';
import { 
  CheckCircle2, 
  FileText, 
  Package, 
  ShieldCheck, 
  ArrowRight, 
  HelpCircle, 
  AlertCircle,
  Truck,
  Building,
  Info,
  Layers,
  Thermometer,
  Compass,
  FileCheck,
  ChevronRight,
  MessageSquare,
  Send,
  Anchor
} from 'lucide-react';

export function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;

// Other commodities for cross-navigation
const otherProducts = productsData.filter((p) => p.slug !== product.slug);

// Comprehensive JSON-LD @graph: Product + BreadcrumbList + FAQPage
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': `https://dhrivaa.com/products/${product.slug}#product`,
      name: product.name,
      description: product.heroDescription,
      image: `https://dhrivaa.com${product.image}`,
      category: 'Agricultural Commodity',
      brand: {
        '@type': 'Brand',
        name: 'DHRIVAA'
      },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        price: 'Contact for Quote',
        priceValidUntil: '2027-12-31',
        availability: 'https://schema.org/InStock',
        seller: {
          '@type': 'Organization',
          name: companyData.name,
          url: 'https://dhrivaa.com'
        }
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://dhrivaa.com/products/${product.slug}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://dhrivaa.com'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Products',
          item: 'https://dhrivaa.com/products'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: product.name,
          item: `https://dhrivaa.com/products/${product.slug}`
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `https://dhrivaa.com/products/${product.slug}#faq`,
      mainEntity: product.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    }
  ]
};

const whatsappProductUrl = `https://wa.me/919987654321?text=${encodeURIComponent(
  `Hello DHRIVAA Trade Desk, I am inquiring regarding sourcing and technical parameters for ${product.name}.`
)}`;
---

<BaseLayout 
  title={product.seo.title} 
  description={product.seo.description}
  keywords={product.seo.keywords}
  jsonLd={jsonLdGraph}
>
  
  <!-- 1. Breadcrumb & Premium Hero with Dark Maritime Theme -->
  <PageHero
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products' },
      { label: product.name }
    ]}
    eyebrow={product.eyebrow}
    title={product.name}
    titleAccent="Sourced for Global Markets."
    description={product.heroDescription}
    bannerImage={product.image}
    bannerAlt={product.alt}
    primaryButton={{
      label: 'Request Specification & Quote',
      href: `/contact?product=${product.slug}`
    }}
    secondaryButton={{
      label: 'View Specifications',
      href: '#specifications'
    }}
    trustTags={[
      { text: 'Origin: Gujarat, India', color: 'teal' },
      { text: 'Ports: Mundra & Kandla (3-5 Days to Gulf)', color: 'gold' },
      { text: 'Independent Pre-Shipment Inspection', color: 'slate' }
    ]}
  />

  <!-- 2. Sticky In-Page Navigation Bar -->
  <nav class="sticky top-20 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 hidden md:block shadow-xs" aria-label="Commodity Navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between py-3 text-xs font-heading font-semibold uppercase tracking-wider">
        <div class="flex items-center gap-6 text-slate-600">
          <a href="#overview" class="hover:text-teal transition-colors">Overview</a>
          <a href="#composition" class="hover:text-teal transition-colors">Composition</a>
          <a href="#applications" class="hover:text-teal transition-colors">Applications</a>
          <a href="#specifications" class="hover:text-teal transition-colors">Specifications</a>
          <a href="#packaging" class="hover:text-teal transition-colors">Packaging</a>
          <a href="#storage" class="hover:text-teal transition-colors">Storage</a>
          <a href="#faqs" class="hover:text-teal transition-colors">FAQs</a>
        </div>
        <div class="flex items-center gap-3">
          <a
            href={whatsappProductUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-slate-700 hover:text-teal transition-colors lowercase font-normal"
          >
            <MessageSquare className="w-3.5 h-3.5 text-teal" />
            <span>Fast WhatsApp Inquiry</span>
          </a>
          <a
            href={`/contact?product=${product.slug}`}
            class="px-4 py-1.5 rounded-full bg-navy-900 hover:bg-navy-800 text-gold-light text-[11px] font-bold uppercase tracking-wider transition-colors"
          >
            Request Quote
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- 3. Executive Commodity Profile & Overview -->
  <section id="overview" class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Summary Card (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
              Commodity Profile
            </span>
            <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
              Executive Overview
            </h2>
            <p class="text-xs text-slate-500 leading-relaxed">
              Direct procurement representation connecting international buyers to verified crushing and extraction units in Gujarat, India.
            </p>
          </div>

          <!-- Quick Specs Snapshot Card -->
          <div class="bg-surface-light p-6 rounded-2xl border border-slate-200/90 shadow-subtle space-y-4 text-xs">
            <span class="font-heading font-bold text-navy-900 uppercase tracking-wider block border-b border-slate-200 pb-2">
              Sourcing Snapshot
            </span>
            
            <div class="space-y-3">
              <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Origin</span>
                <span class="font-bold text-navy-900">Gujarat & Western India</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Shipping Seaports</span>
                <span class="font-bold text-navy-900">Mundra & Kandla (Deendayal)</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Transit to UAE</span>
                <span class="font-bold text-teal">3 – 5 Days Direct Voyage</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Standard Minimum Order</span>
                <span class="font-bold text-navy-900">1 x 20ft FCL (Containerized)</span>
              </div>
              <div class="flex justify-between items-center py-1">
                <span class="text-slate-500">Inspection Protocol</span>
                <span class="font-bold text-navy-900">SGS / Bureau Veritas / Export Inspection Agency</span>
              </div>
            </div>

            <div class="pt-2">
              <a
                href={whatsappProductUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-teal/10 hover:bg-teal/20 text-teal font-heading font-bold text-xs uppercase tracking-wider transition-colors"
              >
                <MessageSquare className="w-3.5 h-3.5" />
                <span>Discuss {product.name} on WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Full Narrative & Policy Box (8 cols) -->
        <div class="lg:col-span-8 space-y-6 text-slate-700 text-base leading-relaxed">
          {product.fullOverview.map((paragraph, idx) => (
            <p class={idx === 0 ? 'text-lg font-normal text-slate-800 leading-relaxed' : ''}>
              {paragraph}
            </p>
          ))}

          <!-- Transparent Procurement Policy Notice -->
          <div class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200/90 text-xs text-amber-950 flex items-start gap-3 mt-6">
            <Info className="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" />
            <div class="space-y-1">
              <p class="font-bold text-amber-900">Independent Procurement Mandate</p>
              <p class="leading-relaxed text-amber-800">
                DHRIVAA negotiates directly with solvent extraction facilities and processing units to procure your designated parameters. <strong>We do not manufacture or own mills; we act exclusively as the buyer’s dedicated commercial coordinator</strong>, verifying quality at the plant gate and seaport warehouse.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Product Composition Profile -->
  <section id="composition" class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-10">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Compositional Benchmarks
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Typical Product Composition
        </h2>
        <p class="text-sm text-slate-600">
          Typical reference parameters for solvent-extracted or refined commodity lots sourced across Indian crushing belts.
        </p>

        <!-- Composition Notice Alert -->
        <div class="p-4 rounded-xl bg-white border border-slate-200 text-xs text-slate-600 flex items-start gap-2.5 mt-3 shadow-xs">
          <AlertCircle className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
          <p>
            {product.compositionNotice}
          </p>
        </div>
      </div>

      <!-- Composition Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {product.composition.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card transition-all space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block font-heading">
                Component Parameter
              </span>
              <h3 class="font-heading font-bold text-base text-navy-900">
                {item.component}
              </h3>
            </div>

            <div class="py-3 px-4 rounded-xl bg-navy-950 text-gold font-mono font-bold text-sm tracking-wide">
              {item.typicalRange}
            </div>

            <div class="pt-2 border-t border-slate-100 text-xs text-slate-600 leading-relaxed">
              <span class="font-semibold text-slate-800">Commercial Role: </span>
              {item.significance}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-slate-200 text-xs text-slate-600">
        <span class="flex items-center gap-2">
          <ShieldCheck className="w-4 h-4 text-teal flex-shrink-0" />
          <span>Need specific formulation thresholds or custom guaranteed minimums?</span>
        </span>
        <a
          href={`/contact?product=${product.slug}`}
          class="font-heading font-bold text-teal hover:text-teal-dark uppercase tracking-wider inline-flex items-center gap-1"
        >
          <span>Submit Custom Target Parameters</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

    </div>
  </section>

  <!-- 5. Commercial Applications -->
  <section id="applications" class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Commercial Usage
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          {product.applicationsHeading}
        </h2>
        <p class="text-sm text-slate-600">
          Sourced according to specific commercial formulations and processing standards for global blenders, integrators, and industrial processors.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {product.applications.map((app, idx) => (
          <div class="bg-surface-light p-8 rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card transition-all space-y-5 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="w-8 h-8 rounded-lg bg-navy-900 text-gold flex items-center justify-center font-mono text-xs font-bold">
                  0{idx + 1}
                </span>
                <span class="text-[10px] uppercase font-bold tracking-wider text-teal font-heading">
                  Target Application
                </span>
              </div>
              <h3 class="font-heading font-bold text-xl text-navy-900">
                {app.title}
              </h3>
              <p class="text-sm text-slate-700 leading-relaxed">
                {app.description}
              </p>
            </div>

            <!-- Target Industry Tags -->
            <div class="pt-4 border-t border-slate-200/80 space-y-2">
              <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block font-heading">
                Typical Consuming Sectors:
              </span>
              <div class="flex flex-wrap gap-2">
                {app.industries.map((ind) => (
                  <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-[11px] font-medium text-slate-700">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 6. Detailed Technical Specifications Matrix -->
  <section id="specifications" class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-10">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Technical Parameters
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Product Specifications
        </h2>
        
        <!-- Specifications Notice Banner -->
        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5 shadow-xs">
          <AlertCircle className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" />
          <p class="font-medium">
            {product.specificationsNotice}
          </p>
        </div>
      </div>

      <!-- Specifications Table with 4 Columns -->
      <div class="overflow-x-auto rounded-2xl border border-slate-200/90 shadow-card bg-white">
        <table class="w-full text-left text-sm text-slate-700">
          <thead class="bg-navy-900 text-white text-xs uppercase tracking-wider font-heading">
            <tr>
              <th scope="col" class="py-4 px-6">Specification Parameter</th>
              <th scope="col" class="py-4 px-6">Coordination Standard</th>
              <th scope="col" class="py-4 px-6">Test Method</th>
              <th scope="col" class="py-4 px-6">Buyer Guidance / Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {product.specifications.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white hover:bg-slate-50/60' : 'bg-slate-50/50 hover:bg-slate-50'}>
                <td class="py-3.5 px-6 font-bold text-navy-900">
                  {row.parameter}
                </td>
                <td class="py-3.5 px-6 font-mono font-semibold text-teal-dark">
                  {row.value}
                </td>
                <td class="py-3.5 px-6 text-xs text-slate-500 font-mono">
                  {row.testMethod || 'Standard Protocol'}
                </td>
                <td class="py-3.5 px-6 text-xs text-slate-600">
                  {row.notes || 'Contract baseline reference'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Table Footnote & Fast Request Action -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-500">
          * Exact dispatch lots are tested and verified by NABL-accredited or international surveyor laboratories prior to vessel loading.
        </p>
        <a
          href={`/contact?product=${product.slug}`}
          class="inline-flex items-center gap-1.5 text-xs font-heading font-bold text-teal hover:text-teal-dark uppercase tracking-wider whitespace-nowrap"
        >
          <span>Request Detailed Laboratory Analysis (COA)</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

    </div>
  </section>

  <!-- 7. Packaging Options & Containerized Stuffing -->
  <section id="packaging" class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Export Packaging &amp; Stuffing
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Packaging Standards &amp; Containerization
        </h2>
        <p class="text-sm text-slate-600">
          Tailored packaging configurations engineered for international maritime transport, warehouse storage, and automated discharge.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {product.packagingOptions.map((opt) => (
          <div class="bg-surface-light p-6 rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card transition-all space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
                <Package className="w-5 h-5" />
              </div>
              <h3 class="font-heading font-bold text-lg text-navy-900">
                {opt.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {opt.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-200/80">
              <span class="text-[10px] uppercase font-bold text-teal tracking-wider block font-heading mb-1">
                Recommended For:
              </span>
              <span class="inline-block px-2.5 py-1 rounded-md bg-teal/10 text-teal text-[11px] font-semibold">
                {opt.suitability}
              </span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 8. Storage, Warehousing & Handling Guidelines -->
  <section id="storage" class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Quality Preservation
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Storage &amp; Handling Best Practices
        </h2>
        <p class="text-sm text-slate-600">
          Professional guidelines for warehouse managers and receiving facilities to prevent moisture migration, caking, or oxidation.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {product.storageGuidelines.map((guide, idx) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-subtle hover:shadow-card transition-all space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-9 h-9 rounded-xl bg-navy-900 text-teal flex items-center justify-center">
                <Thermometer className="w-4 h-4" />
              </div>
              <h3 class="font-heading font-bold text-base text-navy-900">
                {guide.aspect}
              </h3>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed flex-grow">
              {guide.recommendation}
            </p>
            <div class="pt-2 border-t border-slate-100 text-[10px] uppercase font-bold text-slate-400 font-heading">
              Preservation Protocol #{idx + 1}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 9. Sourcing Capabilities & Quality Documentation (2 Large Cards) -->
  <section id="sourcing" class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Sourcing Capabilities -->
        <div class="bg-surface-light p-8 rounded-2xl border border-slate-200/90 shadow-card space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
              <Building className="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl text-navy-900">
                Regional Sourcing Access
              </h3>
              <p class="text-xs text-slate-500">Gujarat Agro-Clustering Advantage</p>
            </div>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            DHRIVAA’s on-ground presence in Gujarat provides direct liaisons across verified crushing units, solvent extractors, and refinery complexes:
          </p>

          <ul class="space-y-3 text-sm text-slate-700" role="list">
            {product.sourcingCapabilities.map((cap) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
                <span>{cap}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Quality Documentation Package -->
        <div class="bg-surface-light p-8 rounded-2xl border border-slate-200/90 shadow-card space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
              <FileCheck className="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl text-navy-900">
                Export Compliance Documentation
              </h3>
              <p class="text-xs text-slate-500">Auditable International Trade Records</p>
            </div>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            Every export shipment coordinated by DHRIVAA includes a full verifiable documentation docket conforming to international customs and banking criteria:
          </p>

          <ul class="space-y-3 text-sm text-slate-700" role="list">
            {product.qualityDocumentationPoints.map((doc) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 className="w-4 h-4 text-gold flex-shrink-0 mt-0.5" />
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- 10. Frequently Asked Questions -->
  <section id="faqs" class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Procurement Clarifications
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-slate-600">
          Key questions regarding sourcing, contracting, ocean freight, and testing for {product.name}.
        </p>
      </div>

      <div class="space-y-4">
        {product.faqs.map((faq) => (
          <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200/90 shadow-subtle space-y-2.5">
            <h3 class="font-heading font-bold text-base sm:text-lg text-navy-900 flex items-start gap-3">
              <HelpCircle className="w-5 h-5 text-gold flex-shrink-0 mt-0.5" />
              <span>{faq.question}</span>
            </h3>
            <p class="text-sm text-slate-600 pl-8 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 11. Contextual In-Page RFQ Action Banner -->
  <section class="py-12 bg-navy-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8 bg-gradient-to-r from-navy-900 to-navy-800 p-8 sm:p-10 rounded-3xl border border-slate-700/60 shadow-elevated">
        <div class="space-y-2 max-w-2xl">
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold font-heading">
            Active Procurement Inquiry
          </span>
          <h3 class="font-heading font-extrabold text-2xl sm:text-3xl text-white">
            Ready to Source {product.name}?
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Share your required quantity, target packaging, and destination port. Our trade desk will structure verified supply options from Gujarat processing mills.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto flex-shrink-0">
          <a
            href={whatsappProductUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-bold text-xs uppercase tracking-wider text-center transition-colors flex items-center justify-center gap-2"
          >
            <MessageSquare className="w-4 h-4" />
            <span>Fast WhatsApp Inquiry</span>
          </a>
          <a
            href={`/contact?product=${product.slug}`}
            class="w-full sm:w-auto px-6 py-3 rounded-full bg-gold hover:bg-gold-light text-navy-950 font-heading font-bold text-xs uppercase tracking-wider text-center transition-colors flex items-center justify-center gap-2"
          >
            <Send className="w-4 h-4" />
            <span>Submit Sourcing Inquiry</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. Related Commodities Showcase -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
            Commodity Portfolio
          </span>
          <h3 class="font-heading font-bold text-xl text-navy-900 mt-1">
            Other Commodities Sourced by DHRIVAA
          </h3>
        </div>
        <a
          href="/products"
          class="text-xs font-heading font-bold text-teal hover:text-teal-dark uppercase tracking-wider hidden sm:inline-flex items-center gap-1"
        >
          <span>View All Products</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {otherProducts.map((p) => (
          <a
            href={`/products/${p.slug}`}
            class="group bg-surface-light rounded-2xl p-6 border border-slate-200/90 shadow-subtle hover:shadow-card hover:border-slate-300 transition-all flex flex-col sm:flex-row gap-6 items-center"
          >
            <div class="w-full sm:w-40 aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 flex-shrink-0">
              <img
                src={p.image}
                alt={p.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="space-y-2 flex-grow">
              <span class="text-[10px] uppercase font-bold text-teal tracking-wider block font-heading">
                {p.eyebrow}
              </span>
              <h4 class="font-heading font-bold text-lg text-navy-900 group-hover:text-teal transition-colors">
                {p.name}
              </h4>
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                {p.shortDescription}
              </p>
              <span class="inline-flex items-center gap-1 text-xs font-bold text-navy-900 group-hover:text-teal pt-1">
                <span>View Specifications</span>
                <ChevronRight className="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- 13. Global Final CTA -->
  <FinalCTA />

</BaseLayout>
