---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productsData, type ProductItem } from '../../data/products';
import { companyData } from '../../data/company';
import {
  CheckCircle2,
  ArrowRight,
  Package,
  MessageSquare,
  ShieldCheck,
  FileText
} from 'lucide-react';

export function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;

const otherProducts = productsData.filter((p) => p.slug !== product.slug);

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': `https://dhrivaa.com/products/${product.slug}#product`,
      name: product.name,
      description: product.heroDescription,
      image: `https://dhrivaa.com${product.image}`,
      category: 'Agricultural Commodity',
      brand: { '@type': 'Brand', name: 'DHRIVAA' },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: companyData.name, url: 'https://dhrivaa.com' }
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dhrivaa.com' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://dhrivaa.com/products' },
        { '@type': 'ListItem', position: 3, name: product.name, item: `https://dhrivaa.com/products/${product.slug}` }
      ]
    }
  ]
};

const whatsappUrl = `https://wa.me/${companyData.phone.replace('+', '')}?text=${encodeURIComponent(
  `Hello DHRIVAA team, I would like to inquire about sourcing ${product.name}.`
)}`;
---

<BaseLayout
  title={`${product.name} | Sourcing & Specifications | ${companyData.name}`}
  description={product.heroDescription}
  keywords={product.seo.keywords}
  jsonLd={jsonLdGraph}
>

  <!-- Breadcrumb -->
  <div class="bg-stone-50 border-b border-stone-200 py-3 sm:py-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span class="text-stone-300">/</span>
        <a href="/products" class="hover:text-stone-900 transition-colors">Products</a>
        <span class="text-stone-300">/</span>
        <span class="text-stone-900 font-semibold">{product.name}</span>
      </nav>
    </div>
  </div>

  <!-- Product Main Overview -->
  <section class="bg-white py-12 sm:py-16 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Product Image (5 cols) -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-stone-200 bg-stone-100 shadow-sm aspect-[4/3] group">
            <img
              src={product.image}
              alt={product.alt}
              class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-103"
              loading="eager"
            />
          </div>
        </div>

        <!-- Product Summary & Action (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-forest">
              {product.eyebrow}
            </span>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-stone-900 tracking-tight">
              {product.name}
            </h1>
            <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
              {product.heroDescription}
            </p>
          </div>

          <!-- Concise Overview Paragraph -->
          <div class="text-xs sm:text-sm text-stone-600 leading-relaxed space-y-2 border-t border-stone-100 pt-4">
            <p>{product.fullOverview[0]}</p>
          </div>

          <!-- Key Procurement Facts Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs pt-2">
            <div class="bg-stone-50 rounded-xl p-3 border border-stone-200">
              <span class="text-stone-400 block text-[11px]">Origin</span>
              <span class="font-semibold text-stone-900 mt-0.5 block">Gujarat, India</span>
            </div>
            <div class="bg-stone-50 rounded-xl p-3 border border-stone-200">
              <span class="text-stone-400 block text-[11px]">Loading Ports</span>
              <span class="font-semibold text-stone-900 mt-0.5 block">Mundra / Kandla</span>
            </div>
            <div class="bg-stone-50 rounded-xl p-3 border border-stone-200">
              <span class="text-stone-400 block text-[11px]">Min Order</span>
              <span class="font-semibold text-stone-900 mt-0.5 block">1 &times; 20ft FCL</span>
            </div>
            <div class="bg-stone-50 rounded-xl p-3 border border-stone-200">
              <span class="text-stone-400 block text-[11px]">Inspection</span>
              <span class="font-semibold text-stone-900 mt-0.5 block">SGS / Geo-Chem</span>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 pt-3">
            <a
              href={`/contact?product=${product.slug}`}
              class="btn-forest flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-full text-xs sm:text-sm font-semibold tracking-wide shadow-subtle hover:shadow-sm"
            >
              <span>Request a Quote for {product.name}</span>
              <ArrowRight className="w-4 h-4" />
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline flex-1 inline-flex items-center justify-center gap-2 py-3 px-5 rounded-full text-xs sm:text-sm font-semibold"
            >
              <MessageSquare className="w-4 h-4 text-[#25D366]" />
              <span>WhatsApp Inquiry</span>
            </a>
          </div>

          <p class="text-[11px] text-stone-500 italic pt-2">
            *DHRIVAA is an independent sourcing and procurement coordinator. We partner directly with verified Indian processing mills; all chemical &amp; physical parameters are confirmed per contract via certified COA.
          </p>

        </div>

      </div>
    </div>
  </section>

  <!-- Key Verified Technical Specifications (Compact Table) -->
  <section id="specifications" class="py-12 sm:py-16 bg-stone-50 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="space-y-1">
        <span class="text-xs font-semibold uppercase tracking-widest text-forest">
          Verified Parameters
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900 tracking-tight">
          Technical Specifications
        </h2>
        <p class="text-xs sm:text-sm text-stone-600">
          {product.specificationsNotice}
        </p>
      </div>

      <!-- Compact Specification Table -->
      <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-subtle">
        <table class="w-full text-xs sm:text-sm text-left">
          <thead>
            <tr class="bg-stone-100/80 border-b border-stone-200 text-stone-700">
              <th class="py-3 px-4 sm:px-6 font-semibold uppercase tracking-wider text-[11px]">Parameter</th>
              <th class="py-3 px-4 sm:px-6 font-semibold uppercase tracking-wider text-[11px]">Typical Value</th>
              <th class="py-3 px-4 sm:px-6 font-semibold uppercase tracking-wider text-[11px] hidden sm:table-cell">Standard / Method</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {product.specifications.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-stone-50/50'}>
                <td class="py-3 px-4 sm:px-6 font-medium text-stone-900">{row.parameter}</td>
                <td class="py-3 px-4 sm:px-6 font-mono font-semibold text-forest">{row.value}</td>
                <td class="py-3 px-4 sm:px-6 text-stone-500 text-xs hidden sm:table-cell">{row.testMethod || 'Standard Export Protocol'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- Applications & Packaging Options -->
  <section class="py-12 sm:py-16 bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Applications -->
      <div class="space-y-6">
        <div class="space-y-1">
          <span class="text-xs font-semibold uppercase tracking-widest text-forest">
            Commercial Usage
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-stone-900 tracking-tight">
            {product.applicationsHeading}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {product.applications.map((app) => (
            <div class="p-4 sm:p-5 rounded-xl border border-stone-200 bg-stone-50 space-y-2">
              <div class="flex items-center gap-2 font-semibold text-stone-900 text-sm">
                <CheckCircle2 className="w-4 h-4 text-forest flex-shrink-0" />
                <span>{app.title}</span>
              </div>
              <p class="text-xs text-stone-600 leading-relaxed pl-6">
                {app.description}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Available Packaging -->
      <div class="space-y-6 pt-6 border-t border-stone-200">
        <div class="space-y-1">
          <span class="text-xs font-semibold uppercase tracking-widest text-forest">
            Export Logistics
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-stone-900 tracking-tight">
            Available Packaging Options
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {product.packagingOptions.map((pkg) => (
            <div class="p-4 sm:p-5 rounded-xl border border-stone-200 bg-stone-50 space-y-2">
              <div class="flex items-center gap-2 font-semibold text-stone-900 text-sm">
                <Package className="w-4 h-4 text-forest flex-shrink-0" />
                <span>{pkg.title}</span>
              </div>
              <p class="text-xs text-stone-600 leading-relaxed">
                {pkg.description}
              </p>
              <span class="inline-block text-[11px] font-medium text-forest pt-1">
                {pkg.suitability}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Request a Quote Section -->
  <section class="py-14 sm:py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
        Request Pricing for {product.name}
      </h2>
      <p class="text-stone-600 text-xs sm:text-sm leading-relaxed max-w-xl mx-auto">
        Share your target volume, discharge port, and packaging preference. Our Gujarat trade desk provides prompt FOB or CIF indications.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={`/contact?product=${product.slug}`}
          class="btn-forest inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide shadow-subtle hover:shadow-sm"
        >
          <span>Request Quotation</span>
          <ArrowRight className="w-4 h-4" />
        </a>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs sm:text-sm font-semibold"
        >
          <MessageSquare className="w-4 h-4 text-[#25D366]" />
          <span>WhatsApp Trade Desk</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
