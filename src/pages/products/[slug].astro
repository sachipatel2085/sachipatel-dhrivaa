---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { productsData, type ProductItem } from '../../data/products';
import { companyData } from '../../data/company';
import { 
  CheckCircle2, 
  FileText, 
  Package, 
  ShieldCheck, 
  ArrowRight, 
  HelpCircle, 
  AlertCircle,
  Truck,
  Building,
  Info
} from 'lucide-react';

export function getStaticPaths() {
  return productsData.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;

// JSON-LD Product & Breadcrumb Schema
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.heroDescription,
  image: `https://dhrivaa.com${product.image}`,
  category: 'Agricultural Commodity',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    price: 'Contact for Quote',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: companyData.name
    }
  }
};
---

<BaseLayout 
  title={product.seo.title} 
  description={product.seo.description}
  keywords={product.seo.keywords}
  jsonLd={productJsonLd}
>
  
  <!-- 1. Breadcrumb & 2. Premium Product Hero with Dark Gradient Overlay & Topic Banner -->
  <PageHero
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products' },
      { label: product.name }
    ]}
    eyebrow={product.eyebrow}
    title={product.name}
    titleAccent="Sourced for Global Markets."
    description={product.heroDescription}
    bannerImage={product.image}
    bannerAlt={product.alt}
    primaryButton={{
      label: 'Request Specification & Quote',
      href: '/contact'
    }}
    secondaryButton={{
      label: 'View Specifications',
      href: '#specifications'
    }}
    trustTags={[
      { text: 'Origin: Gujarat, India', color: 'teal' },
      { text: 'Ports: Mundra & Kandla', color: 'gold' },
      { text: 'COA Available on Request', color: 'slate' }
    ]}
  />

  <!-- 3. Product Overview -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-4 space-y-3">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
            Commodity Profile
          </span>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
            Product Overview
          </h2>
          <p class="text-xs text-slate-500 leading-relaxed">
            Buyer-centric procurement coordination across Gujarat processing hubs.
          </p>
        </div>

        <div class="lg:col-span-8 space-y-4 text-slate-700 text-base leading-relaxed">
          {product.fullOverview.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 flex items-start gap-3 mt-4">
            <Info className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
            <p>
              <strong>Procurement Policy:</strong> DHRIVAA negotiates directly with solvent extraction facilities and crushing units to procure your designated parameters. We do not manufacture; we represent the buyer's quality mandate.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Product Applications -->
  <section class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Target Sectors
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          {product.applicationsHeading}
        </h2>
        <p class="text-sm text-slate-600">
          Sourced according to specific commercial formulations and processing standards.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {product.applications.map((app, idx) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-subtle hover:shadow-card transition-all space-y-3">
            <div class="w-8 h-8 rounded-lg bg-teal/10 text-teal flex items-center justify-center font-mono text-xs font-bold">
              0{idx + 1}
            </div>
            <p class="text-sm text-slate-800 font-medium leading-relaxed">
              {app}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Product Specifications -->
  <section id="specifications" class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-10">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Technical Parameters
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Product Specifications
        </h2>
        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
          <AlertCircle className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" />
          <p class="font-medium">
            {product.specificationsNotice}
          </p>
        </div>
      </div>

      <!-- Specifications Table -->
      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-subtle">
        <table class="w-full text-left text-sm text-slate-700">
          <thead class="bg-navy-900 text-white text-xs uppercase tracking-wider font-heading">
            <tr>
              <th scope="col" class="py-3.5 px-6">Specification Parameter</th>
              <th scope="col" class="py-3.5 px-6">Coordination Standard</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {product.specifications.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                <td class="py-3.5 px-6 font-semibold text-navy-900">
                  {row.parameter}
                </td>
                <td class="py-3.5 px-6 text-slate-600">
                  {row.value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 text-right">
        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 text-xs font-heading font-bold text-teal hover:text-teal-dark uppercase tracking-wider"
        >
          <span>Request Detailed Laboratory Analysis (COA)</span>
          &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- 6. Packaging Options & 7. Sourcing Capabilities -->
  <section class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- 6. Packaging Options -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-card space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
              <Package className="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl text-navy-900">
                Packaging Options
              </h3>
              <p class="text-xs text-slate-500">Containerized export packing standards</p>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-slate-700" role="list">
            {product.packagingOptions.map((opt) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 className="w-4 h-4 text-teal flex-shrink-0 mt-0.5" />
                <span>{opt}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 7. Sourcing Capabilities -->
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-card space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold flex items-center justify-center flex-shrink-0">
              <Building className="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-heading font-bold text-xl text-navy-900">
                Sourcing Capabilities
              </h3>
              <p class="text-xs text-slate-500">Regional Indian market access</p>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-slate-700" role="list">
            {product.sourcingCapabilities.map((cap) => (
              <li class="flex items-start gap-3">
                <CheckCircle2 className="w-4 h-4 text-gold flex-shrink-0 mt-0.5" />
                <span>{cap}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- 8. Quality Documentation -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-3 mb-10">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Trade Compliance
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Quality Documentation
        </h2>
        <p class="text-sm text-slate-600">
          We ensure every dispatch is backed by comprehensive, auditable trade documentation.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {product.qualityDocumentationPoints.map((doc, idx) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-3 flex flex-col justify-between">
            <div class="w-8 h-8 rounded-lg bg-navy-900 text-gold flex items-center justify-center">
              <FileText className="w-4 h-4" />
            </div>
            <p class="text-slate-800 font-medium leading-relaxed flex-grow">
              {doc}
            </p>
            <span class="text-[10px] uppercase font-bold text-teal tracking-wider pt-2 border-t border-slate-200">
              Contract Verified
            </span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 9. Frequently Asked Questions -->
  <section class="py-16 lg:py-20 bg-surface-light border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center space-y-3 mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-teal font-heading">
          Procurement Clarifications
        </span>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-navy-900 tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-slate-600">
          Key questions regarding sourcing and contracting for {product.name}.
        </p>
      </div>

      <div class="space-y-4">
        {product.faqs.map((faq) => (
          <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-subtle space-y-2">
            <h3 class="font-heading font-bold text-base sm:text-lg text-navy-900 flex items-start gap-2.5">
              <HelpCircle className="w-5 h-5 text-gold flex-shrink-0 mt-0.5" />
              <span>{faq.question}</span>
            </h3>
            <p class="text-sm text-slate-600 pl-7 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 10. Request a Quote CTA -->
  <FinalCTA />

</BaseLayout>
