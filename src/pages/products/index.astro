---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productsData } from '../../data/products';
import { companyData } from '../../data/company';
import { ArrowRight, Package, ShieldCheck } from 'lucide-react';

const pageTitle = `Agricultural Commodities & Products | ${companyData.name}`;
const pageDescription = 'Explore agricultural commodities sourced by DHRIVAA from Gujarat, India: Rapeseed Meal, Castorseed Meal, and Castor Oil with verified technical specifications.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Header / Breadcrumb -->
  <section class="bg-stone-50 py-12 sm:py-16 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span class="text-stone-300">/</span>
        <span class="text-stone-900 font-medium">Products</span>
      </nav>

      <span class="text-xs font-semibold uppercase tracking-widest text-forest block">
        Commodity Portfolio
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight leading-tight">
        Agricultural Commodities <span class="font-editorial font-normal italic text-forest">Sourced by DHRIVAA</span>
      </h1>
      <p class="text-stone-600 text-base sm:text-lg max-w-2xl leading-relaxed">
        Sourced directly from verified processing plants in Gujarat and western India to your technical specifications, with third-party pre-shipment testing and export logistics.
      </p>
    </div>
  </section>

  <!-- Commodity Cards Section -->
  <section class="py-16 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {productsData.map((product, idx) => (
          <article class={`reveal-on-scroll delay-${(idx + 1) * 100} bg-stone-50 rounded-2xl overflow-hidden border border-stone-200 hover:border-forest/40 hover-lift transition-all duration-300 flex flex-col justify-between group`}>
            
            <!-- Photograph -->
            <div class="relative aspect-[4/3] overflow-hidden bg-stone-100">
              <img
                src={product.image}
                alt={product.alt}
                class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-104"
                loading="lazy"
              />
            </div>

            <!-- Details -->
            <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <span class="text-[10px] uppercase tracking-wider font-semibold text-forest block">
                  {product.eyebrow}
                </span>
                <h2 class="text-xl font-bold text-stone-900 group-hover:text-forest transition-colors">
                  {product.name}
                </h2>
                <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                  {product.shortDescription}
                </p>
              </div>

              <!-- View Details Link -->
              <div class="pt-3 border-t border-stone-200/70">
                <a
                  href={`/products/${product.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-stone-900 group-hover:text-forest transition-colors"
                >
                  <span>View Details &amp; Specifications</span>
                  <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>

      <!-- Sourcing Notice -->
      <div class="mt-12 p-5 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <ShieldCheck className="w-5 h-5 text-forest shrink-0" />
          <p class="text-xs text-stone-600 leading-relaxed">
            All commodity parameters, packaging standards, and moisture limits are verified per contract through independent laboratory testing (SGS / Geo-Chem).
          </p>
        </div>
        <a
          href="/contact"
          class="btn-forest shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold"
        >
          <span>Request a Quote</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
