---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import ContactForm from '../components/contact/ContactForm';
import { companyData } from '../data/company';
import { Mail, Phone, MapPin, MessageSquare, Clock, Globe, ShieldCheck } from 'lucide-react';

const pageTitle = `Contact Trade Coordination | ${companyData.name} – Global Trade Partner`;
const pageDescription = 'Get in touch with DHRIVAA’s agricultural commodity sourcing team. Inquire about Rapeseed Meal, Castorseed Meal, or Castor Oil procurement from Gujarat, India.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Cinematic Hero Header with Dark Gradient Overlay & Maritime Terminal Banner -->
  <PageHero
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Contact' }
    ]}
    eyebrow="PROCUREMENT DESK · GLOBAL TRADE LIAISON"
    title="Let's Discuss."
    titleAccent="Your Sourcing Requirements."
    description="We are here to understand your sourcing needs, evaluate product parameters, and structure reliable supply options from India across the UAE, Saudi Arabia, and global markets."
    bannerImage="/images/banner-contact.jpg"
    bannerAlt="International container shipping terminal and berthed cargo ship at twilight with harbor reflections"
    primaryButton={{
      label: 'Direct WhatsApp Chat',
      href: companyData.whatsappUrl
    }}
    secondaryButton={{
      label: 'Email Trade Desk',
      href: `mailto:${companyData.email}`
    }}
    trustTags={[
      { text: 'Gujarat, India Hub', color: 'teal' },
      { text: 'Prompt Mandate Review', color: 'gold' },
      { text: 'FCL Procurement Mandates', color: 'slate' }
    ]}
  />

  <!-- Main Contact Section: Left Info, Right Form -->
  <section class="py-16 lg:py-24 bg-surface-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Contact Details & Quick Links (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="bg-white rounded-2xl p-8 border border-slate-200/90 shadow-card space-y-6">
            <h2 class="font-heading font-bold text-xl text-navy-900 border-b border-slate-100 pb-4">
              Trade Coordination Desk
            </h2>

            <!-- Contact List -->
            <div class="space-y-5 text-sm text-slate-600">
              
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-teal flex items-center justify-center flex-shrink-0">
                  <MapPin className="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Sourcing Location</span>
                  <p class="font-semibold text-navy-900 text-base mt-0.5">{companyData.location}</p>
                  <p class="text-xs text-slate-500 mt-0.5">Gateway to Mundra &amp; Kandla Seaports</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-teal flex items-center justify-center flex-shrink-0">
                  <Mail className="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Electronic Inquiries</span>
                  <a href={`mailto:${companyData.email}`} class="font-semibold text-navy-900 hover:text-teal transition-colors text-base mt-0.5 block">
                    {companyData.email}
                  </a>
                  <p class="text-xs text-slate-500 mt-0.5">Official procurement correspondence</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-navy-900 text-teal flex items-center justify-center flex-shrink-0">
                  <Phone className="w-5 h-5" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Direct Telephone</span>
                  <a href={`tel:${companyData.phone}`} class="font-semibold text-navy-900 hover:text-teal transition-colors text-base mt-0.5 block">
                    {companyData.phoneDisplay}
                  </a>
                  <p class="text-xs text-slate-500 mt-0.5">Mon – Sat: 09:00 AM – 07:00 PM IST</p>
                </div>
              </div>

            </div>

            <!-- WhatsApp Direct Action -->
            <div class="pt-4 border-t border-slate-100">
              <a
                href={companyData.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white font-heading font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-md hover:shadow-lg"
              >
                <MessageSquare className="w-4 h-4" />
                <span>Chat on WhatsApp Directly</span>
              </a>
            </div>

          </div>

          <!-- Trade Territory Card -->
          <div class="bg-navy-900 text-white rounded-2xl p-7 border border-navy-800 space-y-4">
            <div class="flex items-center gap-2 text-gold">
              <Globe className="w-5 h-5" />
              <h3 class="font-heading font-bold text-base">Key Trade Destinations</h3>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Serving industrial commodity buyers, feed millers, and agricultural distributors across:
            </p>
            <div class="flex flex-wrap gap-2 text-xs">
              {['UAE', 'Saudi Arabia', 'Oman', 'Qatar', 'Bahrain', 'Kuwait'].map((m) => (
                <span class="px-3 py-1 rounded-full bg-navy-850 border border-slate-700 text-slate-200 font-medium">
                  {m}
                </span>
              ))}
            </div>
          </div>

        </div>

        <!-- Right: Interactive Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
