---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm';
import { companyData } from '../data/company';
import { Mail, Phone, MapPin, MessageSquare, Clock, ShieldCheck } from 'lucide-react';

const pageTitle = `Contact Trade Coordination | ${companyData.name} – Global Trade Partner`;
const pageDescription = 'Contact DHRIVAA’s agricultural commodity sourcing desk in Gujarat, India. Submit inquiries for Rapeseed Meal, Castorseed Meal, or Castor Oil procurement.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Header / Breadcrumb -->
  <section class="bg-stone-50 py-12 sm:py-16 border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span class="text-stone-300">/</span>
        <span class="text-stone-900 font-semibold">Contact</span>
      </nav>

      <span class="text-xs font-semibold uppercase tracking-widest text-forest block">
        Direct Procurement Desk
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 tracking-tight leading-tight">
        Contact <span class="font-editorial font-normal italic text-forest">DHRIVAA</span>
      </h1>
      <p class="text-stone-600 text-base sm:text-lg max-w-2xl leading-relaxed">
        Get in touch with our Gujarat sourcing desk for verified commodity specifications, indicative pricing, and shipping schedules to your destination port.
      </p>
    </div>
  </section>

  <!-- Clean Two-Column Contact Section -->
  <section class="py-16 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Left: Verified Details (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="space-y-2">
            <h2 class="text-xl sm:text-2xl font-bold text-stone-900 tracking-tight">
              Sourcing Coordination Desk
            </h2>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              We review commercial inquiries promptly. Reach out by inquiry form, email, or direct WhatsApp trade chat.
            </p>
          </div>

          <!-- Contact Cards -->
          <div class="space-y-4 text-xs sm:text-sm">
            
            <!-- Email -->
            <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-1">
              <div class="flex items-center gap-2 text-stone-500 text-xs">
                <Mail className="w-4 h-4 text-forest" />
                <span>Email Correspondence</span>
              </div>
              <a href={`mailto:${companyData.email}`} class="font-semibold text-stone-900 hover:text-forest transition-colors block text-sm">
                {companyData.email}
              </a>
              <span class="text-[11px] text-stone-400 block">Official procurement correspondence</span>
            </div>

            <!-- WhatsApp -->
            <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-1">
              <div class="flex items-center gap-2 text-stone-500 text-xs">
                <MessageSquare className="w-4 h-4 text-[#25D366]" />
                <span>Direct WhatsApp Chat</span>
              </div>
              <a
                href={companyData.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-stone-900 hover:text-forest transition-colors block text-sm"
              >
                {companyData.phoneDisplay}
              </a>
              <span class="text-[11px] text-stone-400 block">Instant trade desk communication</span>
            </div>

            <!-- Address / Location -->
            <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-1">
              <div class="flex items-center gap-2 text-stone-500 text-xs">
                <MapPin className="w-4 h-4 text-forest" />
                <span>Verified Business Location</span>
              </div>
              <p class="font-semibold text-stone-900 text-sm">{companyData.location}</p>
              <span class="text-[11px] text-stone-400 block">Western India Agro Processing Corridor &bull; Mundra &amp; Kandla Seaports</span>
            </div>

            <!-- Operating Hours -->
            <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-1">
              <div class="flex items-center gap-2 text-stone-500 text-xs">
                <Clock className="w-4 h-4 text-forest" />
                <span>Trade Desk Hours</span>
              </div>
              <p class="font-semibold text-stone-900 text-sm">Monday &ndash; Saturday: 09:00 AM &ndash; 07:00 PM IST</p>
              <span class="text-[11px] text-stone-400 block">Inquiries received outside hours answered next business day</span>
            </div>

          </div>

          <!-- Compliance Note -->
          <div class="p-4 rounded-xl bg-stone-100 border border-stone-200 text-xs text-stone-600 flex items-start gap-2.5">
            <ShieldCheck className="w-4 h-4 text-forest shrink-0 mt-0.5" />
            <p class="leading-relaxed text-[11px] text-stone-500">
              *DHRIVAA operates as an independent sourcing and procurement coordinator. We partner with verified Indian crushing mills; we do not manufacture.
            </p>
          </div>

        </div>

        <!-- Right: Inquiry Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
